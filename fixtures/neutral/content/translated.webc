<h1>Translated components</h1>
<norn-search lang="fr" @bundle="/assets/pagefind/pagefind.js" @site="example.com">
	<span slot="label">Rechercher</span>
	<span slot="none">Aucun résultat</span>
	<span slot="results-one">{count} résultat</span>
	<span slot="results-other">{count} résultats</span>
</norn-search>
<norn-notice lang="fr"><span slot="prefix">Remarque : </span><p>Le site change bientôt.</p></norn-notice>
<norn-data-table id="headed" lang="fr">
	<table>
		<thead><tr><th>Nom</th><th>Valeur</th><th>Description</th></tr></thead>
		<tbody><tr><td>largeur</td><td>100</td><td><code>une-valeur-assez-longue-pour-faire-défiler-le-tableau</code></td></tr></tbody>
	</table>
</norn-data-table>
<div dir="rtl" lang="ar">
