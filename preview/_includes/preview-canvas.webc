 */

/**
 * A story in a frame, with the controls to look at it differently: color scheme, width, and an accessibility check.
 * Applies the overrides from the page's `preview-props` table. Without a script it is the frame and a link to open it on its own.
 * @prop {{ title: string, frameUrl: string }} story
 */
--->
<div data-js>
	<norn-segmented-control data-group="scheme" :@icon-only="true">
		<span slot="legend">Color scheme</span>
		<label title="Light"><input type="radio" value="light" /><norn-icon @name="sun"></norn-icon><span>Light</span></label>
		<label title="System"><input type="radio" value="" checked /><norn-icon @name="system"></norn-icon><span>System</span></label>
		<label title="Dark"><input type="radio" value="dark" /><norn-icon @name="moon"></norn-icon><span>Dark</span></label>
	</norn-segmented-control>
	<norn-segmented-control data-group="width" :@icon-only="true">
		<span slot="legend">Width</span>
		<label title="Fill"><input type="radio" value="" checked /><norn-icon @name="fill"></norn-icon><span>Fill</span></label>
		<label title="Phone, 320px"><input type="radio" value="320px" /><norn-icon @name="phone"></norn-icon><span>Phone, 320px</span></label>
		<label title="Tablet, 768px"><input type="radio" value="768px" /><norn-icon @name="tablet"></norn-icon><span>Tablet, 768px</span></label>
		<label title="Desktop, 1024px"><input type="radio" value="1024px" /><norn-icon @name="desktop"></norn-icon><span>Desktop, 1024px</span></label>
	</norn-segmented-control>
	<button type="button" data-action="axe" data-state="idle" :data-axe="url('/assets/axe.min.js')">
		<norn-icon @name="accessibility" data-for="idle"></norn-icon>
		<norn-icon @name="loading" data-for="running"></norn-icon>
		<norn-icon @name="success" data-for="pass"></norn-icon>
		<norn-icon @name="error" data-for="fail"></norn-icon>
		Check accessibility
	</button>
</div>
<div data-stage>
	<iframe :src="story.frameUrl" :title="story.title + ' preview'" loading="lazy"></iframe>
</div>
<p><a :href="story.frameUrl">Open on its own</a></p>
<div data-results role="status"></div>
<style>
	@layer norn.components {
		preview-canvas {
			display: grid;
			gap: var(--norn-space-s);
		}

		preview-canvas:not(:defined) [data-js] {
			display: none;
		}

		preview-canvas > div:first-child {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--norn-space-s) var(--norn-space-m);
			font-size: 0.9rem;
		}

		preview-canvas button {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			min-block-size: 2.25rem;
			padding: 0.25rem 0.7rem;
			border: 1px solid var(--norn-ui-border-color);
			border-radius: var(--norn-ui-border-radius);
			background: var(--norn-surface-base);
			color: var(--norn-text-base);
			font: inherit;
			cursor: pointer;
		}

		preview-canvas button norn-icon {
			--norn-icon-size: 1.15rem;
		}

		/* One icon per state: idle, running, pass, fail. */
		preview-canvas button:not([data-state="idle"]) [data-for="idle"],
		preview-canvas button:not([data-state="running"]) [data-for="running"],
		preview-canvas button:not([data-state="pass"]) [data-for="pass"],
		preview-canvas button:not([data-state="fail"]) [data-for="fail"] {
			display: none;
		}

		preview-canvas [data-for="pass"] {
			color: light-dark(#0b6b3a, #7ed6a1);
		}

		preview-canvas [data-for="fail"] {
			color: light-dark(#b42318, #ff8a80);
		}

		@media (prefers-reduced-motion: no-preference) {
			preview-canvas [data-for="running"] svg {
				animation: preview-spin 0.8s linear infinite;
			}
		}

		@keyframes preview-spin {
			to {
				rotate: 1turn;
			}
		}

		preview-canvas p {
			margin: 0;
			font-size: 0.9rem;
		}

		preview-canvas [data-stage] {
			overflow-x: auto;
			padding: var(--norn-space-s);
			border: 1px dashed var(--norn-ui-border-color);
			border-radius: var(--norn-ui-border-radius);
			background: var(--norn-surface-raised);
		}

		preview-canvas iframe {
			display: block;
			inline-size: var(--canvas-width, 100%);
			max-inline-size: none;
			min-block-size: 4rem;
			margin-inline: auto;
			border: 0;
			background: var(--norn-surface-base);
		}

		preview-canvas [data-results]:empty {
			display: none;
		}

		preview-canvas [data-results] {
			padding: var(--norn-space-s) var(--norn-space-m);
			border: 1px solid var(--norn-ui-border-color);
			border-radius: var(--norn-ui-border-radius);
			font-size: 0.9rem;
		}

		preview-canvas [data-results] ul {
			margin: 0.25rem 0 0;
			padding-inline-start: 1.25rem;
		}

		@media print {
			preview-canvas [data-js] {
				display: none;
			}
		}
	}
</style>
<script>
	{
		const TAGS = ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa", "best-practice"];
		let canvases = 0;

		/** A story's frame with its controls. Safe to connect again: the listeners go on once. */
		class PreviewCanvas extends HTMLElement {
			#wired = false;
			#observer;
			#onProps = () => this.#apply(this.querySelector("iframe"));

			connectedCallback() {
				document.addEventListener("previewpropschange", this.#onProps);
				if (this.#wired) return;
				this.#wired = true;
				const frame = this.querySelector("iframe");

				// Radios share a group by name, so each canvas names its own: two canvases on a page must not share a selection.
				const id = ++canvases;
				for (const group of this.querySelectorAll("[data-group]")) {
					for (const input of group.querySelectorAll("input")) input.name = `${group.dataset.group}-${id}`;
				}

				frame.addEventListener("load", () => this.#attach(frame));
				if (frame.contentDocument?.readyState === "complete") this.#attach(frame);

				this.addEventListener("change", (event) => {
					const group = event.target.closest("[data-group]")?.dataset.group;
					if (group === "scheme") this.#apply(frame);
					if (group === "width") {
						this.querySelector("[data-stage]").style.setProperty("--canvas-width", event.target.value || "100%");
						this.#fit(frame);
					}
				});
				this.querySelector('[data-action="axe"]').addEventListener("click", () => this.#check(frame));
			}

			disconnectedCallback() {
				document.removeEventListener("previewpropschange", this.#onProps);
				this.#observer?.disconnect();
				this.#wired = false;
			}

			/** Follow the frame's height, and carry the controls into a fresh document. */
			#attach(frame) {
				const doc = frame.contentDocument;
				if (!doc?.body) return;
				this.#observer?.disconnect();
				this.#observer = new ResizeObserver(() => this.#fit(frame));
				this.#observer.observe(doc.body);
				this.#apply(frame);
				this.#fit(frame);
			}

			#fit(frame) {
				const doc = frame.contentDocument;
				if (doc) frame.style.blockSize = `${doc.documentElement.scrollHeight}px`;
			}

			/** Write the scheme and the page's property overrides into the frame's root element. */
			#apply(frame) {
				const root = frame?.contentDocument?.documentElement;
				if (!root) return;
				root.style.colorScheme = this.querySelector('[data-group="scheme"] input:checked')?.value ?? "";
				const overrides = document.querySelector("preview-props")?.values ?? new Map();
				for (const name of [...root.style].filter((name) => name.startsWith("--"))) {
					if (!overrides.has(name)) root.style.removeProperty(name);
				}
				for (const [name, value] of overrides) root.style.setProperty(name, value);
				this.#fit(frame);
			}

			/** Run axe in the frame and list what it finds. The button's icon shows the state. */
			async #check(frame) {
				const button = this.querySelector('[data-action="axe"]');
				const results = this.querySelector("[data-results]");
				button.dataset.state = "running";
				button.setAttribute("aria-busy", "true");
				results.textContent = "Checking…";
				try {
					const doc = frame.contentDocument;
					if (!frame.contentWindow.axe) {
						await new Promise((resolve, reject) => {
							const script = doc.createElement("script");
							script.src = new URL(button.dataset.axe, location.href).href;
							script.addEventListener("load", resolve);
							script.addEventListener("error", reject);
							doc.head.append(script);
						});
					}
					const { violations } = await frame.contentWindow.axe.run(doc, { runOnly: { type: "tag", values: TAGS } });
					button.dataset.state = violations.length ? "fail" : "pass";
					if (!violations.length) {
						results.textContent = "No accessibility violations found.";
						return;
					}
					const heading = document.createElement("strong");
					heading.textContent = `${violations.length} accessibility ${violations.length === 1 ? "violation" : "violations"}`;
					const list = document.createElement("ul");
					for (const violation of violations) {
						const item = document.createElement("li");
						item.textContent = `${violation.help} (${violation.id}, ${violation.impact}): ${violation.nodes.length} ${violation.nodes.length === 1 ? "element" : "elements"}`;
						list.append(item);
					}
					results.replaceChildren(heading, list);
				} catch {
					button.dataset.state = "fail";
					results.textContent = "The check could not run.";
				} finally {
					button.removeAttribute("aria-busy");
				}
			}
		}

		if (!customElements.get("preview-canvas")) customElements.define("preview-canvas", PreviewCanvas);
	}
</script>
