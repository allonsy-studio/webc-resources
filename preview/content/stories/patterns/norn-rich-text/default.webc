<norn-rich-text>
	<p>Prose styles cover what Markdown produces. A paragraph with <code>inline code</code> and a <a href="https://example.com/">link</a>.</p>
	<h2>A second-level heading</h2>
	<ul>
		<li>A list item</li>
		<li>Another, with enough text that it wraps in a narrow frame, to show the line length and the wrapping</li>
	</ul>
	<ol>
		<li>First</li>
		<li>Second</li>
	</ol>
	<h3>A third-level heading</h3>
	<blockquote>A quotation, set off with a bar.</blockquote>
	<table>
		<thead><tr><th>Option</th><th>Default</th></tr></thead>
		<tbody>
			<tr><td><code>exclude</code></td><td><code>[]</code></td></tr>
			<tr><td><code>prefix</code></td><td><code>"/"</code></td></tr>
		</tbody>
	</table>
	<hr />
	<p>After the rule.</p>
</norn-rich-text>
