{
	"private": true,
	"name": "webc",
	"version": "0.0.0",
	"description": "WebC component packages for Eleventy sites: generic patterns, build-time code samples, & the OSS site theme.",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/webc-resources.git"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"fixtures/*",
		"preview"
	],
	"scripts": {
		"build": "node scripts/build-components.js",
		"llms": "node scripts/build-llms.js",
		"format": "opx lint --fix",
		"lint": "opx lint",
		"pack:check": "yarn build && yarn workspaces foreach --all --no-private pack --dry-run",
		"prepare": "husky",
		"docs:start": "yarn build && yarn workspace webc-preview start",
		"docs:build": "yarn build && yarn workspace webc-preview build",
		"release": "yarn build && opx release publish",
		"test": "yarn build && node --test",
		"version-packages": "opx release version && yarn install --mode update-lockfile"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.8",
		"@11ty/eleventy-plugin-webc": "^0.11.2",
		"@allons-y/opx-cli": "0.1.0-beta.0",
		"@allons-y/opx-lint-js": "^0.1.0-beta.0",
		"@allons-y/opx-lint-json": "0.1.0-beta.0",
		"@allons-y/opx-lint-md": "0.1.0-beta.0",
		"@allons-y/opx-release": "0.1.0-beta.0",
		"@csstools/postcss-design-tokens": "^5.0.2",
		"@eslint/css": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^8.0.3",
		"axe-core": "^4.14.0",
		"css-tree": "^2.3.1",
		"eslint": "^10.14.0",
		"eslint-plugin-license-header": "^0.9.0",
		"eslint-scope": "^9.1.2",
		"espree": "^10.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"parse5": "^7.3.0",
		"playwright-core": "^1.65.0",
		"postcss": "^8.5.32",
		"postcss-html": "^2.0.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@4.18.1"
}
