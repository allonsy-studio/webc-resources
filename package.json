{
	"private": true,
	"name": "@allons-y/webc",
	"version": "0.0.0",
	"description": "WebC component packages for Eleventy sites: generic patterns, build-time code samples, & the studio open source site layer.",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/webc-resources.git"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"fixtures/*"
	],
	"scripts": {
		"format": "opx lint --fix",
		"lint": "opx lint",
		"pack:check": "yarn workspaces foreach --all --no-private pack --dry-run",
		"prepare": "husky",
		"release": "opx release publish",
		"test": "node --test",
		"version-packages": "opx release version && yarn install --mode update-lockfile"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-plugin-webc": "^0.11.2",
		"@allons-y/opx-cli": "^0.1.0-beta.0",
		"@allons-y/opx-lint-js": "^0.1.0-beta.0",
		"@allons-y/opx-lint-json": "^0.1.0-beta.0",
		"@allons-y/opx-lint-md": "^0.1.0-beta.0",
		"@allons-y/opx-release": "^0.1.0-beta.0",
		"@eslint/css": "^1.4.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.1",
		"@eslint/markdown": "^8.0.3",
		"eslint": "^10.8.0",
		"eslint-plugin-license-header": "^0.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "yarn@4.18.1"
}
