<!---
/*
 * SPDX-License-Identifier: MPL-2.0
 * This Source Code Form is subject to the terms of the Mozilla Public
 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * Code sample tokenized at build time. Its script registers `norn-code-block` as a custom element that adds the highlight colors; without the script the markup is the whole sample.
 * A `norn-copy-button` from `@allons-y/webc-patterns` sits in the caption row, above the code, and copies the code without any leading `$ ` prompts. The code reads left to right in any page direction.
 * Needs `tokenRanges` registered as the `nornTokenRanges` JavaScript function, and the patterns package's components.
 * The names and the copy button's texts are in the page, hidden: the script names the code while it scrolls, and shows the button.
 * Each falls back to the site's `componentStrings`, under `norn-code-block` for `label` and `copy-label` and under `norn-copy-button` for the rest, then English.
 * @prop {string} code
 * @prop {string} [language] - A Prism language. Unknown or empty renders plain text.
 * @prop {string} [caption] - Also names the code and its copy button.
 * @slot label - The code's name without a caption, as one element. Falls back to "{language} code", with the language filled in, or "code" with no language.
 * @slot copy-label - The copy button's name, with `{name}` for the code's name, as one element. Falls back to "Copy {name} to clipboard".
 * @slot copy - The copy button's text. Falls back to "Copy".
 * @slot copied - The copy button's text after a copy. Falls back to "Copied".
 * @slot failed - The copy button's text when the copy fails. Falls back to "Copy failed".
 * @cssprop --norn-code-block-bg - Background. Falls back to --norn-surface-code.
 * @cssprop --norn-code-block-fg - Text color. Falls back to --norn-text-base.
 * @cssprop --norn-code-block-border - Border color. Falls back to --norn-ui-border-color.
 * @cssprop --norn-code-block-radius - Corner radius. Falls back to --norn-ui-border-radius.
 * @cssprop --norn-code-block-padding - Inner spacing. Falls back to --norn-space-m.
 * @cssprop --norn-code-block-font - Font stack. Falls back to --norn-font-mono.
 * @cssprop --norn-code-block-shadow - Terminal frame shadow. Falls back to --norn-ui-shadow.
 * @cssprop --norn-code-block-dot-1 - First terminal dot. Falls back to GrayText.
 * @cssprop --norn-code-block-dot-2 - Second terminal dot. Falls back to GrayText.
 * @cssprop --norn-code-block-dot-3 - Third terminal dot. Falls back to GrayText.
 * @cssprop --norn-chrome - Inherited. Set to `terminal` on an ancestor for the window-bar frame.
 * @cssprop --norn-code-comment - Syntax color, with a light-dark default.
 * @cssprop --norn-code-string - Syntax color, with a light-dark default.
 * @cssprop --norn-code-keyword - Syntax color, with a light-dark default.
 * @cssprop --norn-code-function - Syntax color, with a light-dark default.
 * @cssprop --norn-code-number - Syntax color, with a light-dark default.
 * @category component
 */
--->
<script webc:setup>
/** The code as it should paste: a leading `$ ` prompt comes off each line, and `$HOME` is untouched. */
const pasteable = (code) =>
	String(code)
		.split("\n")
		.map((line) => line.replace(/^\$\s+/, ""))
		.join("\n");

/** The code's default name: the label template with the language in it. */
const nameOf = (language, label) =>
	(typeof label === "string" && label ? label : "{language} code")
		.replaceAll("{language}", typeof language === "string" ? language : "")
		.replace(/\s+/g, " ")
		.trim();
</script>
<figure>
	<figcaption webc:if="caption" @text="caption"></figcaption>
	<norn-copy-button :@value="pasteable(code)" :@strings="'norn-code-block-' + uid"></norn-copy-button>
	<pre dir="ltr" :data-language="typeof language === 'string' && language ? language : undefined"><code :data-tokens="nornTokenRanges(code, language)" @text="code"></code></pre>
	<span hidden :id="'norn-code-block-' + uid">
		<span data-string="label" :id="'norn-code-block-' + uid + '-copy'"><slot name="copy-label"><span webc:nokeep @text="nornComponentStrings?.('norn-code-block', 'copy-label', $data.page) || 'Copy {name} to clipboard'"></span></slot></span>
		<span data-string="copy"><slot name="copy"><span webc:nokeep @text="nornComponentStrings?.('norn-copy-button', 'copy', $data.page) || 'Copy'"></span></slot></span>
		<span data-string="copied"><slot name="copied"><span webc:nokeep @text="nornComponentStrings?.('norn-copy-button', 'copied', $data.page) || 'Copied'"></span></slot></span>
		<span data-string="failed"><slot name="failed"><span webc:nokeep @text="nornComponentStrings?.('norn-copy-button', 'failed', $data.page) || 'Copy failed'"></span></slot></span>
	</span>
	<span data-name hidden><slot name="label"><span data-default @text="nameOf(language, nornComponentStrings?.('norn-code-block', 'label', $data.page))"></span></slot></span>
</figure>
<style>
	@layer norn.components {
		norn-code-block {
			display: block;

			/* The caption and the copy button share the first row; the code spans the second. */
			& figure {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: end;
				margin: 0;
			}

			& figcaption {
				grid-area: 1 / 1;
				margin-block-end: var(--norn-space-xs, t('space.xs'));
				color: var(--norn-text-muted, t('text.muted'));
				font-family: var(--norn-code-block-font, var(--norn-font-mono, t('font.mono')));
				font-size: 0.85rem;
			}

			& norn-copy-button {
				grid-area: 1 / 2;
				justify-self: end;

				&:has(button:not([hidden])) {
					margin-block-end: var(--norn-space-xs, t('space.xs'));
				}
			}

			& pre {
				box-sizing: border-box;
				grid-area: 2 / 1 / 3 / 3;
				margin: 0;
				overflow-x: auto;
				padding: var(--norn-code-block-padding, var(--norn-space-m, t('space.m')));
				border: 1px solid var(--norn-code-block-border, var(--norn-ui-border-color, t('ui.border.color')));
				border-radius: var(--norn-code-block-radius, var(--norn-ui-border-radius, t('ui.border.radius')));
				background: var(--norn-code-block-bg, var(--norn-surface-code, t('surface.code')));
				color: var(--norn-code-block-fg, var(--norn-text-base, t('text.base')));
				font-family: var(--norn-code-block-font, var(--norn-font-mono, t('font.mono')));
				font-size: 0.9rem;
				line-height: 1.5;
			}

			& code {
				padding: 0;
				background: none;
				font: inherit;
			}

			/* Window-bar frame, set with `--norn-chrome: terminal` on an ancestor. */
			@container style(--norn-chrome: terminal) {
				& figure {
					box-sizing: border-box;
					inline-size: min(100%, 40rem);
					justify-self: start;
					overflow: hidden;
					border: 1px solid var(--norn-code-block-border, var(--norn-ui-border-color, t('ui.border.color')));
					border-radius: var(--norn-code-block-radius, var(--norn-ui-border-radius, t('ui.border.radius')));
					box-shadow: var(--norn-code-block-shadow, var(--norn-ui-shadow, t('ui.shadow')));

					&::before {
						box-sizing: border-box;
						content: "";
						grid-area: 1 / 1 / 2 / 3;
						block-size: 2.25rem;
						border-block-end: 1px solid var(--norn-code-block-border, var(--norn-ui-border-color, t('ui.border.color')));
						background: radial-gradient(circle 0.35rem at 1.1rem 50%, var(--norn-code-block-dot-1, GrayText) calc(100% - 1px), transparent),
							radial-gradient(circle 0.35rem at 2.1rem 50%, var(--norn-code-block-dot-2, GrayText) calc(100% - 1px), transparent),
							radial-gradient(circle 0.35rem at 3.1rem 50%, var(--norn-code-block-dot-3, GrayText) calc(100% - 1px), transparent),
							var(--norn-surface-raised, t('surface.raised'));
					}
				}

				& figcaption {
					align-self: center;
					margin: 0;
					padding-inline-start: 4.25rem;
				}

				& norn-copy-button:has(button:not([hidden])) {
					align-self: center;
					margin: 0 var(--norn-space-xs, t('space.xs'));
				}

				& pre {
					border: 0;
					border-radius: 0;
				}
			}

			/* Colors for the ranges the script registers. Plain text without Custom Highlight API support. */
			&::highlight(tok-comment) {
				color: var(--norn-code-comment, t('code.comment'));
			}

			&::highlight(tok-string) {
				color: var(--norn-code-string, t('code.string'));
			}

			&::highlight(tok-keyword) {
				color: var(--norn-code-keyword, t('code.keyword'));
			}

			&::highlight(tok-function) {
				color: var(--norn-code-function, t('code.function'));
			}

			&::highlight(tok-number) {
				color: var(--norn-code-number, t('code.number'));
			}

			&::highlight(tok-punctuation) {
				color: var(--norn-text-muted, t('text.muted'));
			}

			@media print {
				break-inside: avoid;

				& pre {
					white-space: pre-wrap;
				}
			}
		}
	}
</style>
<script>
	{
		/** The ranges of every connected sample, by sample. The Custom Highlight API registry is shared by the page. */
		const rangesBySample = new Map();
		const painted = new Set();

		/** Color every connected sample from the ranges the build wrote. */
		const paint = () => {
			if (typeof CSS === "undefined" || !("highlights" in CSS)) return;
			const groups = new Map();
			for (const found of rangesBySample.values()) {
				for (const [group, range] of found) groups.set(group, [...(groups.get(group) ?? []), range]);
			}
			for (const group of painted) {
				if (!groups.has(group)) CSS.highlights.delete(`tok-${group}`);
			}
			painted.clear();
			for (const [group, ranges] of groups) {
				CSS.highlights.set(`tok-${group}`, new Highlight(...ranges));
				painted.add(group);
			}
		};

		/**
		 * Code sample enhancements. The server-rendered figure, caption, and code are the whole component without a script:
		 * this adds the highlight colors, the copy button's name, and a tab stop only while the code scrolls.
		 */
		class CodeBlock extends HTMLElement {
			#observer;

			connectedCallback() {
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", () => this.isConnected && this.#enhance(), { once: true });
					return;
				}
				this.#enhance();
			}

			disconnectedCallback() {
				rangesBySample.delete(this);
				paint();
				this.#observer?.disconnect();
				this.#observer = undefined;
			}

			/** Safe to run again: a move reconnects the element. */
			#enhance() {
				const pre = this.querySelector("pre");
				if (!pre) return;
				const name = this.#name();
				this.#nameCopyButton(name);
				this.#highlight(pre.querySelector("code[data-tokens]"));
				this.#watchOverflow(pre, name);
			}

			/** What names the code: its caption, else the `label` text. Either gets an id from the texts' holder, for `aria-labelledby`. */
			#name() {
				const holder = this.querySelector(":scope > figure > span[hidden][id]");
				const named = this.querySelector(":scope > figure > figcaption") ?? this.querySelector(":scope > figure > [data-name]");
				if (named && holder) named.id ||= `${holder.id}-name`;
				return named;
			}

			/** Put the code's name in the copy button's, where it has `{name}`. Once filled, it has none left. */
			#nameCopyButton(name) {
				const label = this.querySelector(':scope > figure > [hidden] > [data-string="label"]');
				if (!label || !name) return;
				const walker = document.createTreeWalker(label, NodeFilter.SHOW_TEXT);
				const words = name.textContent.trim();
				while (walker.nextNode()) walker.currentNode.data = walker.currentNode.data.replaceAll("{name}", words);
			}

			/** A sample whose token data is unusable stays plain. */
			#highlight(code) {
				rangesBySample.delete(this);
				try {
					const text = code?.firstChild;
					if (text) {
						rangesBySample.set(
							this,
							JSON.parse(code.dataset.tokens).map(([group, start, end]) => {
								const range = new Range();
								range.setStart(text, start);
								range.setEnd(text, end);
								return [group, range];
							}),
						);
					}
				} catch {
					rangesBySample.delete(this);
				}
				paint();
			}


			/** Keep the code a named, focusable region only while it scrolls: a tab stop is for something to scroll. */
			#watchOverflow(pre, name) {
				const fit = () => {
					if (pre.scrollWidth > pre.clientWidth) {
						pre.setAttribute("tabindex", "0");
						if (name?.id) {
							pre.setAttribute("role", "region");
							pre.setAttribute("aria-labelledby", name.id);
						}
					} else {
						pre.removeAttribute("tabindex");
						pre.removeAttribute("role");
						pre.removeAttribute("aria-labelledby");
					}
				};
				document.fonts?.ready.then(fit);
				this.#observer?.disconnect();
				if (typeof ResizeObserver === "undefined") return;
				this.#observer = new ResizeObserver(fit);
				this.#observer.observe(pre);
			}
		}

		if (!customElements.get("norn-code-block")) customElements.define("norn-code-block", CodeBlock);
	}
</script>
