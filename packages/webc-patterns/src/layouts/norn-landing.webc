---
layout: norn-base.webc
nornCompiled: true
---
<!---
/*
 * SPDX-License-Identifier: MPL-2.0
 * This Source Code Form is subject to the terms of the Mozilla Public
 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */
--->
<norn-hero>
	<h1 webc:if="$data.norn.name">
		<span @text="$data.norn.name"></span>
		<span webc:if="$data.norn.tagline" @text="$data.norn.tagline"></span>
	</h1>
	<p webc:if="$data.norn.lede || $data.norn.description" @text="$data.norn.lede || $data.norn.description"></p>
	<nav webc:if="$data.norn.install || $data.norn.repo" aria-labelledby="norn-landing-actions">
		<span id="norn-landing-actions" hidden @text="nornComponentStrings?.('norn-landing', 'actions', $data.page) || 'Get started'"></span>
		<ul role="list">
			<li webc:if="$data.norn.install"><norn-link-button @href="#install"><span webc:nokeep @text="nornComponentStrings?.('norn-landing', 'start', $data.page) || 'Get started'"></span></norn-link-button></li>
			<li webc:if="$data.norn.repo"><norn-link-button :@href="$data.norn.repo" :@variant="$data.norn.install ? 'secondary' : 'primary'"><span webc:nokeep @text="nornComponentStrings?.('norn-landing', 'repo', $data.page) || 'View on GitHub'"></span></norn-link-button></li>
		</ul>
	</nav>
	<norn-fact-list @gap="l">
		<li><norn-icon @name="check"></norn-icon><span webc:nokeep @text="nornComponentStrings?.('norn-landing', 'free', $data.page) || 'Free & open source'"></span></li>
		<li webc:if="$data.norn.license"><norn-icon @name="check"></norn-icon><span @text="(nornComponentStrings?.('norn-landing', 'license', $data.page) || 'License: {license}').replace('{license}', $data.norn.license)"></span></li>
		<li webc:if="$data.norn.node"><norn-icon @name="check"></norn-icon><span @text="(nornComponentStrings?.('norn-landing', 'node', $data.page) || 'Node {node}').replace('{node}', $data.norn.node)"></span></li>
	</norn-fact-list>
	<template webc:nokeep>
		<norn-code-block webc:if="$data.norn.usage" id="usage" :@language="$data.norn.usage.language" :@code="$data.norn.usage.code" :@caption="$data.norn.usage.caption"></norn-code-block>
		<norn-code-block webc:elseif="$data.norn.install" id="install" @language="sh" :@code="$data.norn.install"></norn-code-block>
	</template>
</norn-hero>
<section webc:if="$data.norn.usage && $data.norn.install" id="install">
	<h2 @text="nornComponentStrings?.('norn-landing', 'install', $data.page) || 'Install'"></h2>
	<norn-code-block @language="sh" :@code="$data.norn.install"></norn-code-block>
</section>
<section webc:if="$data.norn.features.length" id="features">
	<h2 @text="nornComponentStrings?.('norn-landing', 'features', $data.page) || 'Features'"></h2>
	<norn-card-grid>
		<li webc:for="feature of $data.norn.features">
			<norn-card>
				<h3>
					<a webc:if="feature.href" :href="feature.href" @text="feature.title"></a>
					<span webc:else @text="feature.title"></span>
				</h3>
				<p @text="feature.description"></p>
			</norn-card>
		</li>
	</norn-card-grid>
</section>
<section webc:if="$data.norn.packages.length" id="packages">
	<h2 @text="nornComponentStrings?.('norn-landing', 'packages', $data.page) || 'Packages'"></h2>
	<norn-card-grid>
		<li webc:for="pkg of $data.norn.packages">
			<norn-card @title-face="mono">
				<h3>
					<a webc:if="pkg.href" :href="pkg.href" @text="pkg.title"></a>
					<span webc:else @text="pkg.title"></span>
				</h3>
				<p @text="pkg.description"></p>
			</norn-card>
		</li>
	</norn-card-grid>
</section>
<section webc:if="String($data.content ?? '').trim()">
	<norn-rich-text
		><template webc:if="nornCompiles($data, 'norn-landing')" webc:nokeep @html="$data.content"></template
		><template webc:else webc:nokeep @raw="$data.content"></template
	></norn-rich-text>
</section>
