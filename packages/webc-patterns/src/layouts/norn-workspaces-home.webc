/**
 * A monorepo's home page: the hero with the install sample, then an index of the workspaces, titles in the mono face. Extends `norn-base`.
 * The page body follows the sections, in a section of its own, in `norn-rich-text`. Markdown is compiled once, as on `norn-docs`, and a page with no body renders no section.
 * The install sample is a `norn-code-block`: highlighted with `@allons-y/webc-code-sample`, and a plain `<pre><code>` without it.
 * Its texts ("Get started", "Browse packages", "View on GitHub", "Packages") come from `componentStrings` under `norn-workspaces-home`, then English.
 * @prop {string} [lede] - The hero paragraph. Falls back to the description.
 * @prop {string} [install] - The install command.
 * @prop {string} [repo] - The repository's URL.
 * @prop {{ name: string, description?: string, url: string }[]} [workspaces] - The workspaces, each with its page.
 * @category template
 */
--->
<norn-hero>
	<h1 webc:if="$data.norn.name">
		<span @text="$data.norn.name"></span>
		<span webc:if="$data.norn.tagline" @text="$data.norn.tagline"></span>
	</h1>
	<p webc:if="$data.norn.lede || $data.norn.description" @text="$data.norn.lede || $data.norn.description"></p>
	<nav webc:if="$data.norn.workspaces.length || $data.norn.repo" aria-labelledby="norn-workspaces-home-actions">
		<span id="norn-workspaces-home-actions" hidden @text="nornComponentStrings?.('norn-workspaces-home', 'actions', $data.page) || 'Get started'"></span>
		<ul role="list">
			<li webc:if="$data.norn.workspaces.length"><norn-link-button @href="#packages"><span webc:nokeep @text="nornComponentStrings?.('norn-workspaces-home', 'browse', $data.page) || 'Browse packages'"></span></norn-link-button></li>
			<li webc:if="$data.norn.repo"><norn-link-button :@href="$data.norn.repo" :@variant="$data.norn.workspaces.length ? 'secondary' : 'primary'"><span webc:nokeep @text="nornComponentStrings?.('norn-workspaces-home', 'repo', $data.page) || 'View on GitHub'"></span></norn-link-button></li>
		</ul>
	</nav>
	<norn-code-block webc:if="$data.norn.install" id="install" @language="sh" :@code="$data.norn.install"></norn-code-block>
</norn-hero>
<section webc:if="$data.norn.workspaces.length" id="packages">
	<h2 @text="nornComponentStrings?.('norn-workspaces-home', 'packages', $data.page) || 'Packages'"></h2>
	<norn-card-grid>
		<li webc:for="workspace of $data.norn.workspaces">
			<norn-card @title-face="mono">
				<h3><a :href="workspace.url" @text="workspace.name || workspace.title"></a></h3>
				<p webc:if="workspace.description" @text="workspace.description"></p>
			</norn-card>
		</li>
	</norn-card-grid>
</section>
<section webc:if="String($data.content ?? '').trim()">
	<norn-rich-text
		><template webc:if="nornCompiles($data, 'norn-workspaces-home')" webc:nokeep @html="$data.content"></template
		><template webc:else webc:nokeep @raw="$data.content"></template
	></norn-rich-text>
</section>
