 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * A docs page: the sticky docs sidebar with site search above its list, the page title, its contents when it has two or more sections, the body in `norn-rich-text`, and the pager. Extends `norn-base`.
 * When the page is 60rem wide or more, the contents are a sticky column at the end of the body. Narrower, they fold under their title, and the sidebar folds into a closed `<details>` under the sidebar's name.
 * The search is live from a Pagefind index at `pagefind/`, or a web search of the site's host without one. Only the page body is indexed.
 * The contents list comes from `nornHeadings` over the body: `headingAnchors`, which the plugin adds to Markdown, writes the anchored headings. With fewer than two, the layout leaves `norn-toc` out, so the page ships none of its CSS or JS.
 * The sidebar's name ("Documentation") and the search label ("Search the docs") come from `componentStrings` under `norn-docs`, then English.
 * @prop {{ url: string, title: string, icon?: string }[]} [docs] - The docs pages, in order. `icon` names a sidebar `norn-icon`.
 * @prop {{ url: string, title: string }} [prev] - Falls back to the page before this one in `docs`, by `nornAdjacent`.
 * @prop {{ url: string, title: string }} [next] - Falls back to the page after this one in `docs`.
 * @prop {{ bundle?: string, site?: string } | false} [search] - Pagefind's script (falls back to `/pagefind/pagefind.js`) and the host the plain form searches (falls back to the host of `url`). `false` leaves the search out.
 * @category template
 */
--->
<norn-sidebar-layout>
	<span slot="summary" @text="nornComponentStrings?.('norn-docs', 'nav', $data.page) || 'Documentation'"></span>
	<norn-side-nav slot="nav" :@items="$data.norn.docs">
		<span slot="label" @text="nornComponentStrings?.('norn-docs', 'nav', $data.page) || 'Documentation'"></span>
		<norn-search
			webc:if="$data.norn.search !== false"
			slot="search"
			:@bundle="($data.norn.search && $data.norn.search.bundle) || url('/pagefind/pagefind.js')"
			:@site="($data.norn.search && $data.norn.search.site) || (/^https?:\/\//.test($data.norn.url || '') ? new URL($data.norn.url).host : '')"
			><span slot="label" @text="nornComponentStrings?.('norn-docs', 'search', $data.page) || 'Search the docs'"></span
		></norn-search>
	</norn-side-nav>
	<h1 @text="$data.norn.title || ''"></h1>
	<template webc:nokeep webc:for="toc of [nornHeadings($data.content)]"><norn-toc webc:if="toc.length > 1" :@items="toc"></norn-toc></template>
	<norn-rich-text data-pagefind-body
		><template webc:if="nornCompiles($data, 'norn-docs')" webc:nokeep @html="$data.content"></template
		><template webc:else webc:nokeep @raw="$data.content"></template
	></norn-rich-text>
	<template webc:nokeep webc:for="pair of [nornAdjacent($data.norn.docs, $data.page)]"
		><norn-pager :@prev="$data.norn.prev !== undefined ? $data.norn.prev : pair.prev" :@next="$data.norn.next !== undefined ? $data.norn.next : pair.next"></norn-pager
	></template>
</norn-sidebar-layout>
<style>
	@layer norn.layout {
		/* The contents sit beside the body once the page is 60rem wide, and fold under their title until then. */
		@container (width < 60rem) {
			norn-sidebar-layout > div > article > norn-toc {
				--norn-toc-fold: on;
			}
		}

		@container (width >= 60rem) {
			norn-sidebar-layout > div > article:has(> norn-toc > nav) {
				--norn-sidebar-layout-columns: minmax(0, 1fr) 12rem;
			}

			norn-sidebar-layout > div > article > * {
				grid-column: 1;
			}

			norn-sidebar-layout > div > article > norn-toc {
				grid-column: 2;
				grid-row: 1 / span 2;
				position: sticky;
				inset-block-start: var(--norn-space-m, t('space.m'));
				align-self: start;
				max-block-size: calc(100dvh - 2 * var(--norn-space-m, t('space.m')));
				overflow-y: auto;
			}
		}
	}
</style>
