<!doctype html>
<html
	:lang="$data.norn.lang"
	:dir="['ltr', 'rtl', 'auto'].includes($data.norn.dir) ? $data.norn.dir : /^(ar|fa|he|iw|ur|ps|yi|ji|dv|ckb|sd|ug)$/i.test(String($data.norn.lang).split(/[-_]/)[0]) ? 'rtl' : 'ltr'"
>
	<head>
		<!---
/*
 * SPDX-License-Identifier: MPL-2.0
 * This Source Code Form is subject to the terms of the Mozilla Public
 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * The page frame every Norn layout extends: the head, the skip link, `norn-header`, `main`, and `norn-footer`, filled from props.
 * The Norn plugin ships it as an Eleventy layout; use it as `layout: norn-base.webc` for a WebC page, or extend it from a layout of the project's own.
 * A page that uses it directly and is not a WebC file, such as Markdown, has its content compiled, so the components the Markdown add-ons write render. Content that is already compiled (a WebC page, or a page on a layout that extends it) is inserted as it is, because compiling it again would render its kept component tags twice. It tells them apart by the page's own `layout` and `page.inputPath`, which a layout chain leaves alone.
 * Props are `$data.norn`: the plugin's `props` mapping, or the same-named page data. Every list defaults to `[]`.
 * The head calls `norn-head`, which declares the cascade layer order first, then embeds the base and print styles: the plugin fills the two style blocks below from `css/base.css` and `css/print.css`. A copy of this file pastes their text in.
 * Four hooks take markup from `fillHooks`: `head` at the end of the head, `banner` before the header, `cta` at the end of `main`, and `credit` as the footer's last column.
 * The footer's texts ("Licensed under {license}", the navigation's name "Footer") come from `componentStrings` under `norn-base`, then English.
 * @prop {string} [lang] - The page language. Falls back to `page.lang`, then `en`.
 * @prop {"ltr" | "rtl" | "auto"} [dir] - The text direction, set on `<html>`. Without it, `rtl` for a right-to-left language (`ar`, `fa`, `he`, `ur`, `ps`, `yi`, `dv`, `ckb`, `sd`, `ug`, matched on the primary subtag of `lang`), else `ltr`.
 * @prop {string} [title] - The page title. The document title is the title and the name; a page without one shows the name and the tagline.
 * @prop {string} [name] - The site name: the brand link, the footer lead, `og:site_name`.
 * @prop {string} [tagline] - A short line after the name.
 * @prop {string} [description]
 * @prop {string} [url] - The canonical URL.
 * @prop {string} [ogTitle] - Falls back to the document title.
 * @prop {{ src: string, alt?: string }} [ogImage] - The share image, or its URL: `og:image`, `og:image:alt`, and `twitter:card` (`summary_large_image`). A relative `src` resolves against `url`, which must then be absolute: with no absolute `url`, the build logs a `norn-head:` warning and `og:image` and `og:image:alt` are left out. Without an image, no image tag renders. Either way the card is `summary`.
 * @prop {string} [locale] - `og:locale`, such as `en_US`.
 * @prop {string} [themeColor] - One color for both schemes. Without it, the page surface in each scheme.
 * @prop {boolean} [themeToggle] - Apply the scheme a `norn-theme-toggle` saved, before the first paint.
 * @prop {{ href: string, type?: string }} [icon] - The favicon, or its URL. Without it the page links an empty icon, so browsers skip `/favicon.ico`.
 * @prop {string} [touchIcon] - A 180px PNG for home screens.
 * @prop {{ src: string, alt?: string }} [logo] - The brand image, or its URL, in place of the name. The brand link renders only with a logo or a name.
 * @prop {{ url: string, title: string, icon?: string }[]} [nav] - The header links. `icon` names a `norn-svg-icon`.
 * @prop {{ name?: string, text?: string, license?: { name: string, url: string }, badges?: { href: string, src: string, alt: string, width?: number, height?: number }[], groups?: { heading: string, links: { url: string, title: string }[] }[], colophon?: string }} [footer] - The footer: the lead column (`name` falls back to the site name, `text` to the tagline), its badges and license, one navigation of grouped links, and a closing line.
 * @category template
 */
--->
		<meta
			webc:is="norn-head"
			webc:nokeep
			:@title="$data.norn.title ? ($data.norn.name && $data.norn.title !== $data.norn.name ? $data.norn.title + ': ' + $data.norn.name : $data.norn.title) : $data.norn.tagline ? $data.norn.name + ': ' + $data.norn.tagline : $data.norn.name || ''"
			:@description="$data.norn.description || ''"
			:@url="typeof $data.norn.url === 'string' ? $data.norn.url : false"
			:@theme-color="$data.norn.themeColor || ''"
			:@og-title="$data.norn.ogTitle || ''"
			:@og-image="$data.norn.ogImage ? $data.norn.ogImage.src : ''"
			:@og-image-alt="$data.norn.ogImage ? $data.norn.ogImage.alt || '' : ''"
			:@theme-toggle="$data.norn.themeToggle ?? false"
		/>
		<meta webc:if="$data.norn.name" property="og:site_name" :content="$data.norn.name" />
		<meta webc:if="$data.norn.locale" property="og:locale" :content="$data.norn.locale" />
		<link webc:if="$data.norn.icon" rel="icon" :href="$data.norn.icon.href" :type="$data.norn.icon.type" />
		<link webc:if="!$data.norn.icon" rel="icon" href="data:," />
		<link webc:if="$data.norn.touchIcon" rel="apple-touch-icon" :href="$data.norn.touchIcon" />
		<template webc:nokeep @html="nornHook('head')"></template>
		<style>/* norn: css/base.css */</style>
		<style>/* norn: css/print.css */</style>
		<style>
			@layer norn.layout {
				norn-footer {
					& [data-badges] {
						display: flex;
						flex-wrap: wrap;
						gap: var(--norn-space-xs, t('space.xs'));
					}

					& [data-badges] img {
						display: block;
						inline-size: auto;
						block-size: 20px;
					}
				}
			}
		</style>
	</head>
	<body>
		<norn-skip-link></norn-skip-link>
		<template webc:nokeep @html="nornHook('banner')"></template>
		<norn-header>
			<a webc:if="$data.norn.logo || $data.norn.name" slot="brand" rel="home" href="/">
				<img webc:if="$data.norn.logo" :src="$data.norn.logo.src" :alt="$data.norn.logo.alt || $data.norn.name || ''" />
				<span webc:else @text="$data.norn.name || ''"></span>
			</a>
			<a webc:for="link of $data.norn.nav" :href="link.url"><norn-svg-icon webc:if="link.icon" :@name="link.icon"></norn-svg-icon><span webc:nokeep @text="link.title"></span></a>
		</norn-header>
		<main id="main" tabindex="-1"><template webc:if="/^norn-base(\.webc)?$/.test(String($data.layout)) && !String($data.page?.inputPath).endsWith('.webc')" webc:nokeep @html="content"></template><template webc:else webc:nokeep @raw="content"></template><template webc:nokeep @html="nornHook('cta')"></template></main>
		<norn-footer>
			<div>
				<p webc:if="$data.norn.footer.name || $data.norn.name"><strong @text="$data.norn.footer.name || $data.norn.name"></strong></p>
				<p webc:if="$data.norn.footer.text || $data.norn.tagline" @text="$data.norn.footer.text || $data.norn.tagline"></p>
				<p webc:if="$data.norn.footer.badges.length" data-badges>
					<a webc:for="badge of $data.norn.footer.badges" :href="badge.href"><img :alt="badge.alt || ''" :src="badge.src" :width="badge.width || false" :height="badge.height || false" loading="lazy" /></a>
				</p>
				<p webc:if="$data.norn.footer.license">
					<small
						><span webc:nokeep @text="(nornComponentStrings?.('norn-base', 'license', $data.page) || 'Licensed under {license}').split('{license}')[0]"></span
						><a :href="$data.norn.footer.license.url" @text="$data.norn.footer.license.name"></a
						><span webc:nokeep @text="(nornComponentStrings?.('norn-base', 'license', $data.page) || 'Licensed under {license}').split('{license}').slice(1).join('')"></span
					></small>
				</p>
			</div>
			<nav webc:if="$data.norn.footer.groups.length" aria-labelledby="norn-base-footer">
				<span id="norn-base-footer" hidden @text="nornComponentStrings?.('norn-base', 'footer', $data.page) || 'Footer'"></span>
				<div webc:for="group of $data.norn.footer.groups">
					<p><strong @text="group.heading"></strong></p>
					<ul>
						<li webc:for="link of group.links"><a :href="link.url" @text="link.title"></a></li>
					</ul>
				</div>
			</nav>
			<template webc:nokeep @html="nornHook('credit')"></template>
			<p webc:if="$data.norn.footer.colophon" slot="colophon"><small @text="$data.norn.footer.colophon"></small></p>
		</norn-footer>
	</body>
</html>
