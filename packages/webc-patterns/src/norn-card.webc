<!---
/*
 * SPDX-License-Identifier: MPL-2.0
 * This Source Code Form is subject to the terms of the Mozilla Public
 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * A card: a heading, then its text, on a raised surface. A heading link makes the whole card a link, and a card with an accent has a 2px line along its top.
 * Pass the heading and body in the default slot, as in `<norn-card><h3><a href="…">Title</a></h3><p>…</p></norn-card>`. Pick the heading level for the outline: h3 under an h2.
 * A link in the heading is stretched over the card, so the card is one target. The pointer over the card takes a hover layer, and focus on the link draws the ring around the card. The link is not underlined until the pointer is over it.
 * `norn-card-grid` sets the inherited `--norn-card-rows` to `subgrid` for its cards. It is not a setting: leave it alone elsewhere.
 * In a `norn-card-grid` the first child, the second, and the third (a footer, such as a link) each take a row shared with the neighboring cards, so they line up. A card with a fourth child lays out on its own.
 * @slot - The heading, then the body.
 * @cssprop --norn-card-bg - Background. Falls back to --norn-surface-raised.
 * @cssprop --norn-card-radius - Corner radius. Falls back to --norn-ui-border-radius.
 * @cssprop --norn-card-padding - Inner spacing. Falls back to --norn-space-m.
 * @cssprop --norn-card-accent - Color of a 2px line along the top. Unset, there is none. Set it on a card, or on the `<li>` of a card in a grid.
 * @cssprop --norn-card-link - Heading link color. Falls back to --norn-text-accent.
 * @cssprop --norn-card-title-face - Inherited. Set to `mono` for a heading in the mono face.
 * @category container
 */
--->
<article><slot></slot></article>
<style>
	@layer norn.components {
		norn-card {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: var(--norn-card-rows, none);
			block-size: 100%;

			/* In a norn-card-grid the card spans three rows, one each for the heading, the body, and a footer, so they line up across a row. */
			& > article {
				--_state: 0%;
				box-sizing: border-box;
				position: relative;
				display: grid;
				grid-row: 1 / -1;
				grid-template-columns: minmax(0, 1fr);
				grid-template-rows: var(--norn-card-rows, none);
				align-content: start;
				row-gap: 0;
				block-size: 100%;
				padding: var(--norn-card-padding, var(--norn-space-m, t('space.m')));
				/* Unset, the accent leaves the declaration invalid, so there is no line and no space for one. */
				border-block-start: 2px solid var(--norn-card-accent);
				border-radius: var(--norn-card-radius, var(--norn-ui-border-radius, t('ui.border.radius')));
				background-color: color-mix(in oklab, currentcolor var(--_state), var(--norn-card-bg, var(--norn-surface-raised, t('surface.raised'))));

				/* A fourth child has no row to take, so a card with more than a heading, a body, and a footer lays out on its own. */
				&:has(> :nth-child(4)) {
					grid-template-rows: none;
				}

				&:has(a:hover) {
					--_state: var(--norn-ui-state-hover, t('ui.state.hover'));
				}

				&:has(a:active) {
					--_state: var(--norn-ui-state-press, t('ui.state.press'));
				}

				/* The ring goes around the card, not around the link text. */
				&:has(a:focus-visible) {
					outline: var(--norn-ui-focus-width, t('ui.focus.width')) solid var(--norn-text-accent, t('text.accent'));
					outline-offset: var(--norn-ui-focus-offset, t('ui.focus.offset'));
				}
			}

			& > article > * {
				margin: 0;
			}

			& > article > :not(:last-child) {
				margin-block-end: var(--norn-space-s, t('space.s'));
			}

			& > article > :is(h2, h3, h4, h5, h6),
			& > article > norn-heading-anchor > :is(h2, h3, h4, h5, h6) {
				font-family: var(--norn-font-heading, t('font.heading'));
				font-size: var(--norn-font-size-l, t('font.size.l'));
				line-height: 1.15;
				text-wrap: balance;
			}

			& > article > :is(h2, h3, h4, h5, h6) a,
			& > article > norn-heading-anchor > :is(h2, h3, h4, h5, h6) a {
				color: var(--norn-card-link, var(--norn-text-accent, t('text.accent')));
				text-decoration: none;
				overflow-wrap: anywhere;

				/* The link reaches over the whole card. */
				&::after {
					content: "";
					position: absolute;
					inset: 0;
				}

				&:hover {
					text-decoration: underline;
				}

				&:focus-visible {
					outline: none;
				}
			}

			& > article > p {
				color: var(--norn-text-muted, t('text.muted'));
				text-wrap: pretty;
			}

			@container style(--norn-card-title-face: mono) {
				& > article > :is(h2, h3, h4, h5, h6),
				& > article > norn-heading-anchor > :is(h2, h3, h4, h5, h6) {
					font-family: var(--norn-font-mono, t('font.mono'));
					font-size: var(--norn-font-size-m, t('font.size.m'));
					font-weight: 700;
				}
			}

			@media (prefers-reduced-motion: no-preference) {
				& > article {
					transition: background-color var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing'));
				}
			}

			@media (forced-colors: active) {
				& > article {
					border: 1px solid CanvasText;
				}
			}

			@media print {
				break-inside: avoid;
			}
		}
	}
</style>
