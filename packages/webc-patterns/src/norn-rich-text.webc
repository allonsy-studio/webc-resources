/**
 * Prose styles for long-form content: h2 and h3, paragraphs, lists, quotes, tables, rules, and inline code.
 * Wrap the content in it: `<norn-rich-text><template webc:nokeep @html="content"></template></norn-rich-text>`.
 * @slot - The prose, as rendered HTML.
 * @cssprop --norn-rich-text-measure - Line length. Falls back to --norn-text-measure.
 * @cssprop --norn-rich-text-rule - Rules in tables and dividers, and the quote bar. Falls back to --norn-ui-border-color.
 * @cssprop --norn-rich-text-code-bg - Inline code background. Falls back to --norn-surface-code.
 * @category container
 */
--->
<slot></slot>
<style>
	@layer norn.components {
		norn-rich-text {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			align-content: start;
			gap: var(--norn-space-m, t('space.m'));
			max-inline-size: var(--norn-rich-text-measure, var(--norn-text-measure, t('text.measure')));
		}

		/* Prose styles stop at the components that style all their own markup. A call-out, a notice, a card, or a table holds prose of its own (a list, a code span), so it stays in scope. */
		@scope (norn-rich-text) to (norn-code-block, norn-code-tabs, norn-tag-list) {
			h2,
			h3 {
				margin: var(--norn-space-s, t('space.s')) 0 0;
				font-family: var(--norn-font-heading, t('font.heading'));
				line-height: 1.15;
				text-wrap: balance;
			}

			/* norn-heading-anchor zeroes its heading's margin, so the space goes on its tag. */
			norn-heading-anchor:has(> :is(h2, h3)) {
				margin-block-start: var(--norn-space-s, t('space.s'));
			}

			:is(h1, h2, h3, h4, h5, h6) {
				/* A heading that links to itself is marked with a #, and its link takes the text color. */
				&:has(> a)::before {
					content: "#" / "";
					margin-inline-end: 0.25em;
				}

				& > a {
					display: inline-block;
					min-block-size: 1.5rem;
					color: inherit;
					text-underline-offset: 0.1em;
				}
			}

			h2 {
				font-size: 1.5rem;
			}

			h3 {
				font-size: 1.2rem;
			}

			p {
				margin: 0;
				text-wrap: pretty;
			}

			ul,
			ol {
				display: grid;
				gap: 0.4rem;
				margin: 0;
				padding-inline-start: 1.25rem;
				list-style: revert;
			}

			blockquote {
				margin: 0;
				padding-inline-start: var(--norn-space-m, t('space.m'));
				border-inline-start: 3px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
				color: var(--norn-text-muted, t('text.muted'));
			}

			table {
				border-collapse: collapse;
				border-block-end: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
			}

			th,
			td {
				padding: var(--norn-space-xs, t('space.xs')) var(--norn-space-s, t('space.s'));
				border-block-end: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
				text-align: start;
			}

			hr {
				box-sizing: border-box;
				width: 100%;
				border: 0;
				border-block-start: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
			}

			:not(pre) > code {
				padding: 0.1em 0.35em;
				border-radius: 0.25rem;
				background: var(--norn-rich-text-code-bg, var(--norn-surface-code, t('surface.code')));
				font-family: var(--norn-font-mono, t('font.mono'));
				font-size: 0.9em;
			}
		}

		/* Without @scope the same rules reach every descendant at zero specificity, and a slotted component's own styles win where they set the property. */
		@supports not at-rule(@scope) {
			norn-rich-text {
				& :where(h2, h3) {
					margin: var(--norn-space-s, t('space.s')) 0 0;
					font-family: var(--norn-font-heading, t('font.heading'));
					line-height: 1.15;
					text-wrap: balance;
				}

				/* A heading that links to itself is marked with a #, and its link takes the text color. */
				& :where(:is(h1, h2, h3, h4, h5, h6):has(> a))::before {
					content: "#" / "";
					margin-inline-end: 0.25em;
				}

				& :where(:is(h1, h2, h3, h4, h5, h6) > a) {
					display: inline-block;
					min-block-size: 1.5rem;
					color: inherit;
					text-underline-offset: 0.1em;
				}

				& :where(h2) {
					font-size: 1.5rem;
				}

				& :where(h3) {
					font-size: 1.2rem;
				}

				& :where(p) {
					margin: 0;
					text-wrap: pretty;
				}

				& :where(ul, ol) {
					display: grid;
					gap: 0.4rem;
					margin: 0;
					padding-inline-start: 1.25rem;
					list-style: revert;
				}

				& :where(blockquote) {
					margin: 0;
					padding-inline-start: var(--norn-space-m, t('space.m'));
					border-inline-start: 3px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
					color: var(--norn-text-muted, t('text.muted'));
				}

				& :where(table) {
					border-collapse: collapse;
					border-block-end: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
				}

				& :where(th, td) {
					padding: var(--norn-space-xs, t('space.xs')) var(--norn-space-s, t('space.s'));
					border-block-end: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
					text-align: start;
				}

				& :where(hr) {
					box-sizing: border-box;
					width: 100%;
					border: 0;
					border-block-start: 1px solid var(--norn-rich-text-rule, var(--norn-ui-border-color, t('ui.border.color')));
				}

				& :where(:not(pre) > code) {
					padding: 0.1em 0.35em;
					border-radius: 0.25rem;
					background: var(--norn-rich-text-code-bg, var(--norn-surface-code, t('surface.code')));
					font-family: var(--norn-font-mono, t('font.mono'));
					font-size: 0.9em;
				}

				/* norn-heading-anchor zeroes its heading's margin, so the space goes on its tag. */
				& :where(norn-heading-anchor:has(> :is(h2, h3))) {
					margin-block-start: var(--norn-space-s, t('space.s'));
				}
			}
		}
	}
</style>
