 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * An aside in long-form text, set apart like a pull quote: a short label with an icon over the body, on a quiet raised panel. Use it for a fun fact, a tip, or a point worth a pause. It is not a status message: use `norn-notice` for one.
 * The kinds match GitHub's alerts and differ only in the label's color, its default text, and its icon. `callouts` in `@allons-y/webc-patterns/markdown` writes the same markup for a Markdown `> [!NOTE]` blockquote. Its role is `note`: it is not a landmark.
 * @prop {string} [variant] - `note`, `tip`, `important`, `warning`, or `caution`. Falls back to `note`.
 * @slot heading - The label over the body, as one element, such as `<span slot="heading">Did you know?</span>`. Falls back to the site's `componentStrings` for the variant, then the variant's name, such as "Note".
 * @slot - The body.
 * @cssprop --norn-callout-color - The label, icon, and rule color. Falls back to --norn-text-accent for `note` and `important`, and to a status color for the others.
 * @cssprop --norn-callout-bg - Background. Falls back to --norn-surface-raised.
 * @category container
 */
--->
<script webc:setup>
const VARIANTS = { note: ["Note", "info"], tip: ["Tip", "tip"], important: ["Important", "important"], warning: ["Warning", "warning"], caution: ["Caution", "caution"] };

/** A known variant, else `note`. */
const kind = (variant) => (Object.hasOwn(VARIANTS, variant) ? variant : "note");
</script>
<div role="note" :data-variant="kind(variant)">
	<p><norn-icon :@name="VARIANTS[kind(variant)][1]"></norn-icon><slot name="heading"><span @text="nornComponentStrings?.('norn-callout', kind(variant), $data.page) || VARIANTS[kind(variant)][0]"></span></slot></p>
	<slot></slot>
</div>
<style>
	@layer norn.components {
		norn-callout {
			--_color: var(--norn-callout-color, var(--norn-text-accent, t('text.accent')));
			display: block;

			&:has(> [data-variant="tip"]) {
				--_color: var(--norn-callout-color, var(--norn-status-success, t('status.success')));
			}

			&:has(> [data-variant="warning"]) {
				--_color: var(--norn-callout-color, var(--norn-status-warning, t('status.warning')));
			}

			&:has(> [data-variant="caution"]) {
				--_color: var(--norn-callout-color, var(--norn-status-danger, t('status.danger')));
			}

			/* A quiet raised panel: a short rule, a small label, then the body set like a pull quote. */
			& > div {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: var(--norn-space-s, t('space.s'));
				padding: var(--norn-space-m, t('space.m')) var(--norn-space-l, t('space.l'));
				overflow-wrap: anywhere;
				border-radius: var(--norn-ui-border-radius, t('ui.border.radius'));
				background: var(--norn-callout-bg, var(--norn-surface-raised, t('surface.raised')));
				color: var(--norn-text-base, t('text.base'));
				font-family: var(--norn-font-heading, t('font.heading'));
				font-size: var(--norn-font-size-l, t('font.size.l'));
				line-height: 1.4;
				text-wrap: pretty;

				&::before {
					content: "";
					inline-size: 2rem;
					block-size: 2px;
					background: var(--_color);
				}
			}

			& > div > p:first-child {
				display: flex;
				align-items: center;
				gap: var(--norn-space-xs, t('space.xs'));
				margin: 0;
				color: var(--_color);
				font-family: var(--norn-font-body, t('font.body'));
				font-size: var(--norn-font-size-s, t('font.size.s'));
				font-weight: 600;
				letter-spacing: 0.08em;
				line-height: 1.15;
				text-transform: uppercase;
			}

			& > div > p:first-child > norn-icon {
				flex: none;
			}

			& > div > :not(:first-child) {
				margin: 0;
			}

			/* A fill that forced colors replaces still shows as a border. */
			@media (forced-colors: active) {
				& > div {
					border: 1px solid CanvasText;
				}
			}

			@media print {
				& > div {
					border: 1px solid currentcolor;
					background: none;
				}
			}
		}
	}
</style>
