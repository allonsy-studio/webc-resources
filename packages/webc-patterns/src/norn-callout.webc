 */

/**
 * An aside within prose: a note, tip, important point, warning, or caution, with an icon and a title, and the body in the default slot.
 * The kinds match GitHub's alerts. `callouts` in `@allons-y/webc-patterns/markdown` writes the same markup for a Markdown `> [!NOTE]` blockquote. Its role is `note`: it is not a landmark.
 * @prop {string} [variant] - `note`, `tip`, `important`, `warning`, or `caution`. Falls back to `note`.
 * @slot heading - The title, as one element, such as `<span slot="heading">Careful</span>`. Falls back to the site's `componentStrings` for the variant, then the variant's name, such as "Note".
 * @slot - The body.
 * @cssprop --norn-callout-color - The bar, icon, and title color. Falls back to a status color per variant, and to --norn-text-accent for `important`.
 * @cssprop --norn-callout-bg - Background. Falls back to a tint of the color.
 * @category container
 */
--->
<script webc:setup>
const VARIANTS = { note: ["Note", "info"], tip: ["Tip", "tip"], important: ["Important", "important"], warning: ["Warning", "warning"], caution: ["Caution", "caution"] };

/** A known variant, else `note`. */
const kind = (variant) => (Object.hasOwn(VARIANTS, variant) ? variant : "note");
</script>
<div role="note" :data-variant="kind(variant)">
	<p><norn-icon :@name="VARIANTS[kind(variant)][1]"></norn-icon><slot name="heading"><span @text="nornComponentStrings?.('norn-callout', kind(variant), $data.page) || VARIANTS[kind(variant)][0]"></span></slot></p>
	<slot></slot>
</div>
<style>
	@layer norn.components {
		norn-callout {
			--_color: var(--norn-callout-color, var(--norn-status-info, t('status.info')));
			display: block;

			&:has(> [data-variant="tip"]) {
				--_color: var(--norn-callout-color, var(--norn-status-success, t('status.success')));
			}

			&:has(> [data-variant="important"]) {
				--_color: var(--norn-callout-color, var(--norn-text-accent, t('text.accent')));
			}

			&:has(> [data-variant="warning"]) {
				--_color: var(--norn-callout-color, var(--norn-status-warning, t('status.warning')));
			}

			&:has(> [data-variant="caution"]) {
				--_color: var(--norn-callout-color, var(--norn-status-danger, t('status.danger')));
			}

			/* A tint and a bar, as in norn-notice. */
			& > div {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				gap: var(--norn-space-2xs, t('space.2xs'));
				padding: var(--norn-space-xs, t('space.xs')) var(--norn-space-m, t('space.m'));
				overflow-wrap: anywhere;
				border-inline-start: 3px solid var(--_color);
				border-start-end-radius: var(--norn-ui-border-radius, t('ui.border.radius'));
				border-end-end-radius: var(--norn-ui-border-radius, t('ui.border.radius'));
				background: var(--norn-callout-bg, color-mix(in oklab, var(--_color) 8%, var(--norn-surface-base, t('surface.base'))));
			}

			& > div > p:first-child {
				display: flex;
				align-items: start;
				gap: var(--norn-space-xs, t('space.xs'));
				margin: 0;
				color: var(--_color);
				font-weight: 600;
			}

			& > div > p:first-child > norn-icon {
				--norn-icon-size: var(--norn-ui-icon-m, t('ui.icon.m'));
				flex: none;
				margin-block-start: calc((1lh - var(--norn-ui-icon-m, t('ui.icon.m'))) / 2);
			}

			& > div > :not(:first-child) {
				margin: 0;
			}

			@media (forced-colors: active) {
				& > div {
					border-inline-start-color: CanvasText;
				}
			}
		}
	}
</style>
