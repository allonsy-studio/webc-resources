/**
 * Responsive grid of cards. Each card takes the next accent color.
 * Pass each card in an `<li>`, as in `<li><norn-content-card>…</norn-content-card></li>`. The list has `role="list"`, which Safari needs once the markers are gone.
 * Each card spans three rows of the grid, with `grid-template-rows: subgrid`, so the headings, the bodies, and the footers of cards in a row line up. A browser without subgrid shows each card as its own box.
 * @slot - The cards, each in an `<li>`.
 * @prop {boolean} [mono] - Set the card titles in the mono face. On for `@mono`, `@mono="true"`, or `:@mono="true"`.
 * @cssprop --norn-card-grid-min - Narrowest card. Falls back to 17rem.
 * @cssprop --norn-card-grid-gap - Space between cards. Falls back to --norn-space-m.
 * @cssprop --norn-card-grid-accent-1 - First accent. Falls back to --norn-feature-1, then --norn-ui-accent.
 * @cssprop --norn-card-grid-accent-2 - Second accent. Falls back to --norn-feature-2, then ActiveText.
 * @cssprop --norn-card-grid-accent-3 - Third accent. Falls back to --norn-feature-3, then VisitedText.
 * @cssprop --norn-card-grid-accent-4 - Fourth accent. Falls back to --norn-feature-4, then GrayText.
 * @category layout
 */
--->
<ul role="list" :style="mono === true || mono === '' || mono === 'true' ? '--norn-content-card-title-face: mono' : ''"><slot></slot></ul>
<style>
	@layer norn.components {
		norn-card-grid {
			display: block;

			& ul {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--norn-card-grid-min, 17rem)), 1fr));
				gap: var(--norn-card-grid-gap, var(--norn-space-m, t('space.m')));
				margin: 0;
				padding: 0;
				list-style: none;
			}

			& ul > li {
				--norn-card-accent: var(--norn-card-grid-accent-1, var(--norn-feature-1, var(--norn-ui-accent, t('ui.accent'))));

				&:nth-child(4n + 2) {
					--norn-card-accent: var(--norn-card-grid-accent-2, var(--norn-feature-2, ActiveText));
				}

				&:nth-child(4n + 3) {
					--norn-card-accent: var(--norn-card-grid-accent-3, var(--norn-feature-3, VisitedText));
				}

				&:nth-child(4n + 4) {
					--norn-card-accent: var(--norn-card-grid-accent-4, var(--norn-feature-4, GrayText));
				}
			}
		}

		/* Each card spans three rows, and its heading, body, and footer take one each, so they line up across a row. The rows have no gap, so a card with no footer leaves no blank space; the space between cards is a margin on each, taken back from the end of the list. */
		@supports (grid-template-rows: subgrid) {
			norn-card-grid {
				& ul {
					row-gap: 0;
					margin-block-end: calc(-1 * var(--norn-card-grid-gap, var(--norn-space-m, t('space.m'))));
				}

				& ul > li {
					display: grid;
					grid-row: span 3;
					grid-template-rows: subgrid;
					--norn-content-card-rows: subgrid;
					margin-block-end: var(--norn-card-grid-gap, var(--norn-space-m, t('space.m')));
				}

				& ul > li > * {
					grid-row: 1 / -1;
				}
			}
		}
	}
</style>
