 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * Sidebar navigation from a list of pages. Marks the current page with `aria-current="page"`, and a page holding it with `aria-current="true"`.
 * An item may carry a `norn-svg-icon` name and child pages, which list under it with a rule down the start edge.
 * In a sticky `norn-page-layout` column only the list scrolls, so a search field in the `search` slot stays put.
 * @prop {{ url: string, title: string, icon?: string, children?: { url: string, title: string }[] }[]} items
 * @slot label - The landmark name, read but not shown, as one element. Falls back to the site's `componentStrings`, then "Pages".
 * @slot search - A search field above the list, as one element.
 * @cssprop --norn-side-nav-link - Link color. Falls back to --norn-text-muted.
 * @cssprop --norn-side-nav-icon - Icon color. Falls back to --norn-text-accent.
 * @cssprop --norn-side-nav-hover - Hover and current page background. Falls back to --norn-surface-raised.
 * @cssprop --norn-side-nav-current - Current page color. Falls back to --norn-text-accent.
 * @cssprop --norn-side-nav-marker - Current page bar. Falls back to --norn-ui-accent.
 * @category landmark
 */
--->
<nav :aria-labelledby="'norn-side-nav-' + uid">
	<span data-label :id="'norn-side-nav-' + uid"><slot name="label"><span webc:nokeep @text="nornComponentStrings?.('norn-side-nav', 'label', $data.page) || 'Pages'"></span></slot></span>
	<slot name="search"></slot>
	<ul>
		<li webc:for="item of items">
			<a
				:href="item.url"
				:aria-current="item.url === $data.page.url ? 'page' : (item.children || []).some((child) => child.url === $data.page.url) ? 'true' : undefined"
			><norn-svg-icon webc:if="item.icon" :@name="item.icon"></norn-svg-icon><span @text="item.title"></span></a>
			<ul webc:if="item.children && item.children.length">
				<li webc:for="child of item.children">
					<a :href="child.url" :aria-current="child.url === $data.page.url ? 'page' : undefined"><span @text="child.title"></span></a>
				</li>
			</ul>
		</li>
	</ul>
</nav>
<style>
	@layer norn.components {
		norn-side-nav {
			display: flex;
			flex-direction: column;
			min-block-size: 0;
			font-size: 0.92rem;

			& nav {
				display: flex;
				flex-direction: column;
				gap: var(--norn-space-s, t('space.s'));
				min-block-size: 0;
			}

			& nav > [data-label] {
				position: absolute;
				inline-size: 1px;
				block-size: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}

			& nav > ul,
			& nav > ul ul {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			/* Padding with an equal negative margin keeps focus rings inside the scroll box, which would clip them. */
			& nav > ul {
				box-sizing: border-box;
				min-block-size: 0;
				margin: -6px;
				padding: 6px;
				overflow-y: auto;
				overscroll-behavior: contain;
			}

			& nav > ul ul {
				margin-block: 0.15rem 0.5rem;
				margin-inline: 0.5rem 0;
				padding-inline-start: 0.75rem;
				border-inline-start: 1px solid var(--norn-ui-border-color, t('ui.border.color'));
			}

			& nav > ul a {
				display: flex;
				align-items: baseline;
				gap: 0.55rem;
				padding: 0.25rem 0.5rem;
				border-start-end-radius: 4px;
				border-end-end-radius: 4px;
				color: var(--norn-side-nav-link, var(--norn-text-muted, t('text.muted')));
				text-decoration: none;
				overflow-wrap: anywhere;

				&:hover {
					background: var(--norn-side-nav-hover, var(--norn-surface-raised, t('surface.raised')));
					color: var(--norn-text-base, t('text.base'));
				}

				&[aria-current="page"] {
					background: var(--norn-side-nav-hover, var(--norn-surface-raised, t('surface.raised')));
					box-shadow: inset 3px 0 0 var(--norn-side-nav-marker, var(--norn-ui-accent, t('ui.accent')));
					color: var(--norn-side-nav-current, var(--norn-text-accent, t('text.accent')));
					font-weight: 600;
				}
			}

			& nav > ul norn-svg-icon {
				flex: none;
				align-self: center;
				color: var(--norn-side-nav-icon, var(--norn-text-accent, t('text.accent')));
			}

			&:dir(rtl) nav > ul a[aria-current="page"] {
				box-shadow: inset -3px 0 0 var(--norn-side-nav-marker, var(--norn-ui-accent, t('ui.accent')));
			}

			@media (forced-colors: active) {
				& nav > ul a[aria-current="page"] {
					outline: 1px solid CanvasText;
				}
			}

			@media print {
				display: none;
			}
		}
	}
</style>
