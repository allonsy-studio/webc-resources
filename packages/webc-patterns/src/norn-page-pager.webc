/**
 * Links to the pages before and after this one. Renders nothing when both are missing.
 * Get the pages from `adjacent`, registered as `nornAdjacent`, at the call site.
 * The arrows are drawn in CSS, not read, and point the other way in right-to-left text.
 * @prop {{ url: string, title: string }} [prev]
 * @prop {{ url: string, title: string }} [next]
 * @slot label - The landmark name, read but not shown, as one element. Falls back to the site's `componentStrings`, then "Pager".
 * @cssprop --norn-page-pager-border - Rule above the links. Falls back to --norn-ui-border-color.
 * @cssprop --norn-page-pager-link - Link color. Falls back to --norn-text-accent.
 * @category landmark
 */
--->
<nav :aria-labelledby="'norn-page-pager-' + uid" webc:if="prev || next">
	<a webc:if="prev" rel="prev" :href="prev.url" @text="prev.title"></a>
	<a webc:if="next" rel="next" :href="next.url" @text="next.title"></a>
	<span data-label :id="'norn-page-pager-' + uid"><slot name="label"><span webc:nokeep @text="nornComponentStrings?.('norn-page-pager', 'label', $data.page) || 'Pager'"></span></slot></span>
</nav>
<style>
	@layer norn.components {
		norn-page-pager {
			display: block;

			& nav {
				display: flex;
				justify-content: space-between;
				gap: var(--norn-space-m, t('space.m'));
				padding-block-start: var(--norn-space-m, t('space.m'));
				border-block-start: 1px solid var(--norn-page-pager-border, var(--norn-ui-border-color, t('ui.border.color')));
			}

			& nav > [data-label] {
				position: absolute;
				inline-size: 1px;
				block-size: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}

			& nav > a {
				color: var(--norn-page-pager-link, var(--norn-text-accent, t('text.accent')));
				text-decoration: underline dotted;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.2em;
				overflow-wrap: break-word;

				&:is(:hover, :focus-visible) {
					text-decoration-style: solid;
				}

				&[rel="prev"]::before {
					content: "← ";
					content: "← " / "";
				}

				&[rel="next"] {
					margin-inline-start: auto;
				}

				&[rel="next"]::after {
					content: " →";
					content: " →" / "";
				}
			}

			&:dir(rtl) nav > a[rel="prev"]::before {
				content: "→ ";
				content: "→ " / "";
			}

			&:dir(rtl) nav > a[rel="next"]::after {
				content: " ←";
				content: " ←" / "";
			}
		}
	}
</style>
