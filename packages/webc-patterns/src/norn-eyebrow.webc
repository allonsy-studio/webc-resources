<p><slot></slot></p>
<style>
	@layer norn.components {
		norn-eyebrow {
			display: block;

			& > p {
				margin: 0;
				color: var(--norn-text-muted, t('text.muted'));
				font-size: var(--norn-font-size-s, t('font.size.s'));
				font-weight: 600;
				line-height: 1.5;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
		}
	}
</style>
