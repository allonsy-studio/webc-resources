 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * A heading that links to itself, so a reader can copy a link to the section. The heading text is the link, with a `#` before it. Where the pointer can hover, the `#` hangs in the margin and shows while the heading is hovered or has focus; elsewhere it stays in line, since there is no hover to reveal it.
 * The default slot is the heading text. `headingAnchors` in `@allons-y/webc-patterns/markdown` writes the same markup for Markdown headings.
 * @prop {string} slug - The heading's id, and the link's fragment. Required: the build fails without it.
 * @prop {number} [level] - 2 to 6. Falls back to 2.
 * @slot - The heading text.
 * @cssprop --norn-heading-anchor-mark - The `#` color. Falls back to --norn-text-muted.
 * @category component
 */
--->
<script webc:setup>
/** The heading's id, after checking it was passed. An unpassed `slug` resolves to a helper of that name under Eleventy, so a type check comes first. */
const required = (value) => {
	if (typeof value !== "string" || !value) throw new Error("norn-heading-anchor: `@slug` is required. It is the heading's id and the link's fragment.");
	return value;
};
</script>
<h3 webc:if="level == 3" :id="required(slug)"><a :href="'#' + slug"><slot></slot></a></h3>
<h4 webc:elseif="level == 4" :id="required(slug)"><a :href="'#' + slug"><slot></slot></a></h4>
<h5 webc:elseif="level == 5" :id="required(slug)"><a :href="'#' + slug"><slot></slot></a></h5>
<h6 webc:elseif="level == 6" :id="required(slug)"><a :href="'#' + slug"><slot></slot></a></h6>
<h2 webc:else :id="required(slug)"><a :href="'#' + slug"><slot></slot></a></h2>
<style>
	@layer norn.components {
		norn-heading-anchor {
			display: block;

			& > :is(h2, h3, h4, h5, h6) {
				margin: 0;
				scroll-margin-block-start: var(--norn-space-m, t('space.m'));

				&::before {
					content: "#" / "";
					margin-inline-end: var(--norn-space-2xs, t('space.2xs'));
					color: var(--norn-heading-anchor-mark, var(--norn-text-muted, t('text.muted')));
				}
			}

			/* At least 24px tall, the WCAG 2.2 target size, even for a short heading. */
			& a {
				display: inline-block;
				min-block-size: 1.5rem;
				color: inherit;
				text-decoration: none;
				text-underline-offset: 0.1em;

				&:is(:hover, :focus-visible) {
					text-decoration: underline;
				}
			}

			@media (hover: hover) {
				& > :is(h2, h3, h4, h5, h6)::before {
					display: inline-block;
					inline-size: 1ch;
					margin-inline: -1.25ch 0.25ch;
					opacity: 0;
				}

				& > :is(h2, h3, h4, h5, h6):is(:hover, :focus-within)::before {
					opacity: 1;
				}
			}

			@media (hover: hover) and (prefers-reduced-motion: no-preference) {
				& > :is(h2, h3, h4, h5, h6)::before {
					transition: opacity var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing'));
				}
			}
		}
	}
</style>
