 * file, You can obtain one at https://mozilla.org/MPL/2.0/.
 */

/**
 * A link styled as a button, for a call to action. It navigates, so it stays a link: use a `<button>` for an action on the page.
 * The default slot is the link text, and may hold a `norn-icon`. A hover and a press take a layer of the text color over the background, and the text is never underlined.
 * @prop {string} href
 * @prop {string} [variant] - `primary`, a filled accent; `secondary`, a 1px outline; or `quiet`, text with no border. Falls back to `primary`.
 * @slot - The link text, which may hold a `norn-icon`.
 * @cssprop --norn-link-button-accent - Primary background. Falls back to --norn-ui-accent.
 * @cssprop --norn-link-button-on-accent - Primary text. Falls back to --norn-text-on-accent, then Canvas.
 * @cssprop --norn-link-button-link - Secondary and quiet text. Falls back to --norn-text-accent.
 * @cssprop --norn-link-button-border - Secondary border color. Falls back to --norn-text-accent.
 * @cssprop --norn-link-button-border-width - Border width. Falls back to 1px.
 * @cssprop --norn-link-button-radius - Corner radius. Falls back to --norn-ui-border-radius.
 * @category component
 */
--->
<a :href="href" :data-variant="variant === 'secondary' || variant === 'quiet' ? variant : 'primary'"><slot></slot></a>
<style>
	@layer norn.components {
		norn-link-button {
			display: inline-flex;
			max-inline-size: 100%;

			& a[data-variant] {
				--_state: 0%;
				--_bg: transparent;
				--_border: transparent;
				box-sizing: border-box;
				display: inline-flex;
				align-items: center;
				gap: var(--norn-space-xs, t('space.xs'));
				min-block-size: var(--norn-ui-control-height, t('ui.control.height'));
				padding: var(--norn-space-2xs, t('space.2xs')) var(--norn-space-m, t('space.m'));
				border: var(--norn-link-button-border-width, 1px) solid var(--_border);
				border-radius: var(--norn-link-button-radius, var(--norn-ui-border-radius, t('ui.border.radius')));
				background-color: color-mix(in oklab, currentcolor var(--_state), var(--_bg));
				color: var(--norn-link-button-link, var(--norn-text-accent, t('text.accent')));
				font-weight: 600;
				line-height: 1.3;
				overflow-wrap: anywhere;
				text-decoration: none;

				&:hover {
					--_state: var(--norn-ui-state-hover, t('ui.state.hover'));
				}

				&:active {
					--_state: var(--norn-ui-state-press, t('ui.state.press'));
				}
			}

			& a[data-variant="primary"] {
				--_bg: var(--norn-link-button-accent, var(--norn-ui-accent, t('ui.accent')));
				color: var(--norn-link-button-on-accent, var(--norn-text-on-accent, t('text.on-accent')));
			}

			& a[data-variant="secondary"] {
				--_border: var(--norn-link-button-border, var(--norn-text-accent, t('text.accent')));
			}

			@media (pointer: coarse) {
				& a[data-variant] {
					min-block-size: 2.75rem;
				}
			}

			@media (prefers-reduced-motion: no-preference) {
				& a[data-variant] {
					transition: background-color var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing'));
				}
			}

			/* The primary button stays filled, since the browser would turn its fill into the page color. */
			@media (forced-colors: active) {
				& a[data-variant="primary"] {
					border-color: LinkText;
					background-color: LinkText;
					color: Canvas;
					forced-color-adjust: none;

					&:focus-visible {
						outline-color: CanvasText;
					}
				}

				& a[data-variant="secondary"] {
					border-color: LinkText;
					color: LinkText;
				}

				/* A clear border would be drawn in the text color, so the quiet button's takes the page's. */
				& a[data-variant="quiet"] {
					border-color: Canvas;
					color: LinkText;
				}
			}
		}
	}
</style>
