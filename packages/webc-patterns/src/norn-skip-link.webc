 */

/**
 * Link that jumps past the page chrome to the main content. Hidden until it has focus.
 * Give the target `tabindex="-1"`, as in `<main id="main" tabindex="-1">`.
 * @prop {string} [href] - The target's fragment. Falls back to `#main`.
 * @slot label - The link text, as one element, such as `<span slot="label">Aller au contenu</span>`. Falls back to the site's `componentStrings`, then "Skip to content".
 * @cssprop --norn-skip-link-bg - Background. Falls back to --norn-surface-raised.
 * @cssprop --norn-skip-link-fg - Text color. Falls back to --norn-text-base.
 * @cssprop --norn-skip-link-radius - Corner radius. Falls back to --norn-ui-border-radius.
 * @category component
 */
--->
<a :href="href || '#main'"><slot name="label"><span webc:nokeep @text="nornComponentStrings?.('norn-skip-link', 'label', $data.page) || 'Skip to content'"></span></slot></a>
<style>
	@layer norn.components {
		norn-skip-link {
			display: block;

			& a {
				position: absolute;
				inset-block-start: -5rem;
				inset-inline-start: var(--norn-space-m, t('space.m'));
				z-index: 10;
				padding: var(--norn-space-xs, t('space.xs')) var(--norn-space-s, t('space.s'));
				border-radius: var(--norn-skip-link-radius, var(--norn-ui-border-radius, t('ui.border.radius')));
				background: var(--norn-skip-link-bg, var(--norn-surface-raised, t('surface.raised')));
				color: var(--norn-skip-link-fg, var(--norn-text-base, t('text.base')));

				&:focus {
					inset-block-start: var(--norn-space-xs, t('space.xs'));
				}
			}

			@media (forced-colors: active) {
				& a {
					border: 1px solid CanvasText;
				}
			}

			@media print {
				display: none;
			}
		}
	}
</style>
