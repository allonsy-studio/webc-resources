 */

/**
 * The same thing in a few forms, such as npm, yarn, and pnpm, as tabs over `norn-code-block`s. Without a script every sample shows, stacked.
 * Pass the samples in the default slot. Each tab is named by the sample's `data-tab` attribute, else its caption, else its `label` slot, else its language, all read from the markup. A name two samples share gets a number after the first, such as `sh` and `sh 2`, so every tab name is its own.
 * The tabs follow the ARIA tabs pattern: arrow keys move between them, in the reading direction, and Home and End jump to the ends. Tabs that share a `@group` switch together, and the choice is remembered in this browser.
 * @prop {string} [group] - Tabs with the same group, on any page, show the same choice.
 * @slot - The samples, each a `norn-code-block`. For the terminal frame, give each sample `@chrome="terminal"`: a slot can't take props from the tabs.
 * @slot label - The tab list's name, as one element, such as `<span slot="label">Install commands</span>`. Falls back to the site's `componentStrings`, then "Code samples".
 * @slot sample - A tab's name when its sample has no `data-tab`, caption, label, or language, with `{n}` for its number. Falls back to the site's `componentStrings`, then "Sample {n}".
 * @category container
 */
--->
<span hidden>
	<span data-string="label" :id="'norn-code-tabs-' + uid"><slot name="label"><span webc:nokeep @text="nornComponentStrings?.('norn-code-tabs', 'label', $data.page) || 'Code samples'"></span></slot></span>
	<span data-string="sample"><slot name="sample"><span webc:nokeep @text="nornComponentStrings?.('norn-code-tabs', 'sample', $data.page) || 'Sample {n}'"></span></slot></span>
</span>
<div :data-group="group || undefined"><slot></slot></div>
<style>
	@layer norn.components {
		norn-code-tabs {
			display: block;

			& > div {
				display: grid;
				gap: var(--norn-space-s, t('space.s'));
			}

			& > div > [role="tablist"] {
				display: flex;
				flex-wrap: wrap;
				gap: var(--norn-space-xs, t('space.xs'));
				border-block-end: 1px solid var(--norn-ui-border-color, t('ui.border.color'));
			}

			& > div > [role="tablist"] > [role="tab"] {
				--_state: 0%;
				box-sizing: border-box;
				min-block-size: var(--norn-ui-control-height, t('ui.control.height'));
				margin-block-end: -1px;
				padding: 0 var(--norn-space-s, t('space.s'));
				border: 0;
				border-block-end: 2px solid transparent;
				border-start-start-radius: var(--norn-ui-radius-s, t('ui.radius.s'));
				border-start-end-radius: var(--norn-ui-radius-s, t('ui.radius.s'));
				background-color: color-mix(in oklab, currentcolor var(--_state), transparent);
				color: var(--norn-text-muted, t('text.muted'));
				font: inherit;
				font-size: var(--norn-font-size-s, t('font.size.s'));
				overflow-wrap: anywhere;
				cursor: pointer;

				&:hover {
					--_state: var(--norn-ui-state-hover, t('ui.state.hover'));
					color: var(--norn-text-base, t('text.base'));
				}

				&:active {
					--_state: var(--norn-ui-state-press, t('ui.state.press'));
				}

				/* The ring sits inside the tab, clear of the underline. */
				&:focus-visible {
					outline-offset: calc(-1 * var(--norn-ui-focus-offset, t('ui.focus.offset')));
				}

				&[aria-selected="true"] {
					border-block-end-color: var(--norn-text-accent, t('text.accent'));
					color: var(--norn-text-accent, t('text.accent'));
					font-weight: 600;
				}
			}

			& > div > [role="tabpanel"][hidden] {
				display: none;
			}

			/* The tab names the sample, so the caption would repeat it. */
			& > div > [role="tabpanel"] figcaption {
				display: none;
			}

			& > div > [role="tabpanel"] figure:has(> figcaption) {
				row-gap: 0;
			}

			@media (pointer: coarse) {
				& > div > [role="tablist"] > [role="tab"] {
					min-block-size: 2.75rem;
				}
			}

			@media (prefers-reduced-motion: no-preference) {
				& > div > [role="tablist"] > [role="tab"] {
					transition: background-color var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing'));
				}
			}

			/* A clear border would be drawn in the text color, so only the selected tab has one. */
			@media (forced-colors: active) {
				& > div > [role="tablist"] > [role="tab"] {
					border-block-end-width: 0;
					padding-block-end: 2px;
				}

				& > div > [role="tablist"] > [role="tab"][aria-selected="true"] {
					border-block-end-width: 2px;
					border-block-end-color: Highlight;
					padding-block-end: 0;
				}
			}

			@media print {
				& > div > [role="tablist"] {
					display: none;
				}

				& > div > [role="tabpanel"][hidden] {
					display: block;
				}
			}
		}
	}
</style>
<script>
	{
		const STORE = "norn-code-tabs:";
		let sets = 0;

		const remembered = (group) => {
			try {
				return group ? localStorage.getItem(STORE + group) : null;
			} catch {
				return null;
			}
		};

		const remember = (group, name) => {
			try {
				if (group) localStorage.setItem(STORE + group, name);
			} catch {
				// Not remembered: the choice holds for this page only.
			}
		};

		/**
		 * A sample's tab name, read from its markup, so it never waits on the code block's script:
		 * its `data-tab`, its caption, the text of its `label` slot when the author filled it, or its language.
		 */
		const nameOf = (panel) => {
			const label = panel.querySelector(":scope > figure > [data-name]");
			return (
				panel.dataset.tab ||
				panel.querySelector("figcaption")?.textContent.trim() ||
				(label && !label.querySelector("[data-default]") ? label.textContent.trim() : "") ||
				panel.querySelector("pre[data-language]")?.dataset.language ||
				""
			);
		};

		/** The names with a repeat made distinct by a number: `sh`, `sh 2`, `sh 3`. A tab name picks a tab, so none can be shared. */
		const distinct = (names) => {
			const used = new Set(names);
			const seen = new Set();
			return names.map((name) => {
				if (!seen.has(name)) {
					seen.add(name);
					return name;
				}
				let count = 2;
				while (used.has(`${name} ${count}`)) count++;
				used.add(`${name} ${count}`);
				return `${name} ${count}`;
			});
		};

		/** Tabs over the code samples in the slot. The stacked samples are the whole component without a script. */
		class CodeTabs extends HTMLElement {
			#sync = (event) => {
				if (event.detail.group === this.#group && event.detail.source !== this) this.#select(event.detail.name, false);
			};

			get #box() {
				return this.querySelector(":scope > div");
			}

			get #group() {
				return this.#box?.dataset.group;
			}

			connectedCallback() {
				document.addEventListener("codetabschange", this.#sync);
				const box = this.#box;
				if (!box || box.querySelector(':scope > [role="tablist"]')) return;
				const panels = [...box.querySelectorAll(":scope > norn-code-block")];
				if (panels.length < 2) return;
				const id = `norn-code-tabs-${++sets}`;
				const strings = this.querySelector(":scope > [hidden]");
				const name = strings?.querySelector('[data-string="label"]');
				const sample = strings?.querySelector('[data-string="sample"]')?.textContent.trim() || "{n}";
				const list = document.createElement("div");
				list.setAttribute("role", "tablist");
				if (name?.id) list.setAttribute("aria-labelledby", name.id);
				const names = distinct(panels.map((panel, index) => nameOf(panel) || sample.replaceAll("{n}", String(index + 1))));
				panels.forEach((panel, index) => {
					const tab = document.createElement("button");
					tab.type = "button";
					tab.id = `${id}-tab-${index}`;
					tab.setAttribute("role", "tab");
					tab.setAttribute("aria-controls", (panel.id ||= `${id}-panel-${index}`));
					tab.textContent = names[index];
					panel.setAttribute("role", "tabpanel");
					panel.setAttribute("aria-labelledby", tab.id);
					list.append(tab);
				});
				box.prepend(list);
				list.addEventListener("click", (event) => {
					const tab = event.target.closest('[role="tab"]');
					if (tab) this.#show(this.#tabs().indexOf(tab), true);
				});
				list.addEventListener("keydown", (event) => this.#key(event));
				const tabs = this.#tabs();
				const saved = remembered(this.#group);
				this.#select(saved, false);
				if (!tabs.some((tab) => tab.getAttribute("aria-selected") === "true")) this.#show(0, false);
			}

			disconnectedCallback() {
				document.removeEventListener("codetabschange", this.#sync);
			}

			#tabs() {
				return [...this.querySelectorAll('[role="tab"]')];
			}

			/** The tab with this name, if any. Names are distinct within a set, so it is the only one. */
			#select(name, chosen) {
				const index = this.#tabs().findIndex((tab) => tab.textContent === name);
				if (index !== -1) this.#show(index, chosen);
			}

			/** Show the tab at this index, and the panel at the same index. A person's choice is remembered and shared with the group; a sync is not passed on. */
			#show(index, chosen) {
				const tabs = this.#tabs();
				const panels = [...this.querySelectorAll(':scope > div > [role="tabpanel"]')];
				tabs.forEach((tab, position) => {
					const selected = position === index;
					tab.setAttribute("aria-selected", String(selected));
					tab.tabIndex = selected ? 0 : -1;
					if (panels[position]) panels[position].hidden = !selected;
				});
				if (!chosen) return;
				const name = tabs[index].textContent;
				remember(this.#group, name);
				if (this.#group) document.dispatchEvent(new CustomEvent("codetabschange", { detail: { group: this.#group, name, source: this } }));
			}

			/** Arrow keys follow the reading direction; Home and End go to the ends. Moving focus selects the tab. */
			#key(event) {
				const tabs = this.#tabs();
				const index = tabs.indexOf(document.activeElement);
				if (index === -1) return;
				const forward = getComputedStyle(this).direction === "rtl" ? "ArrowLeft" : "ArrowRight";
				const backward = forward === "ArrowRight" ? "ArrowLeft" : "ArrowRight";
				const next = { [forward]: (index + 1) % tabs.length, [backward]: (index - 1 + tabs.length) % tabs.length, Home: 0, End: tabs.length - 1 }[event.key];
				if (next === undefined) return;
				event.preventDefault();
				tabs[next].focus();
				this.#show(next, true);
			}
		}

		if (!customElements.get("norn-code-tabs")) customElements.define("norn-code-tabs", CodeTabs);
	}
</script>
