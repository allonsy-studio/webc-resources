 */
--->
<script webc:setup>
/** The options, after checking they come with the name that makes their radios one group. */
const grouped = (options, name) => {
	if (options && (typeof name !== "string" || !name)) throw new Error("norn-segmented-control: `:@options` needs `@name`, or each radio is its own group and several can be checked at once.");
	return options;
};

/** Reached only from the `legend` slot's fallback: a group without a name fails the build. */
const unnamed = () => {
	throw new Error('norn-segmented-control: the group needs a name. Put one element in the `legend` slot, such as `<span slot="legend">Size</span>`.');
};
</script>
<fieldset :data-icon-only="iconOnly === true || iconOnly === '' || iconOnly === 'true' ? '' : undefined">
	<legend><slot name="legend"><span webc:nokeep @text="unnamed()"></span></slot></legend>
	<template webc:nokeep webc:if="grouped(options, name)">
		<label webc:for="option of options" :title="option.label">
			<input type="radio" :name="name" :value="option.value" :checked="option.checked ? '' : undefined" />
			<norn-icon webc:if="option.icon" :@name="option.icon" @size="m"></norn-icon>
			<span @text="option.label"></span>
		</label>
	</template>
	<slot webc:else></slot>
</fieldset>
<style>
	@layer norn.components {
		norn-segmented-control {
			--_gap: 2px;
			--_current: var(--norn-text-accent, t('text.accent'));
			display: inline-flex;
			max-inline-size: 100%;

			& fieldset {
				box-sizing: border-box;
				display: grid;
				grid-auto-columns: minmax(0, 1fr);
				grid-auto-flow: column;
				gap: var(--_gap);
				min-inline-size: 0;
				margin: 0;
				padding: var(--_gap);
				border: 0;
				border-radius: var(--norn-ui-border-radius, t('ui.border.radius'));
				background: var(--norn-surface-raised, t('surface.raised'));
			}

			& legend,
			& [data-icon-only] label > span {
				box-sizing: border-box;
				position: absolute;
				inline-size: 1px;
				block-size: 1px;
				overflow: hidden;
				clip-path: inset(50%);
				white-space: nowrap;
			}

			/* The radio covers its label, so a click anywhere on the option selects it, and the native control keeps the focus. */
			& label {
				--_state: 0%;
				--_tint: transparent;
				box-sizing: border-box;
				position: relative;
				z-index: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: var(--norn-space-2xs, t('space.2xs'));
				min-inline-size: 2.5rem;
				min-block-size: calc(var(--norn-ui-control-height, t('ui.control.height')) - 2 * var(--_gap));
				padding-inline: var(--norn-space-s, t('space.s'));
				border-radius: calc(var(--norn-ui-border-radius, t('ui.border.radius')) - var(--_gap));
				background-color: color-mix(in oklab, currentcolor var(--_state), var(--_tint));
				color: var(--norn-text-muted, t('text.muted'));
				cursor: pointer;
				overflow-wrap: anywhere;
				text-align: center;

				&:hover {
					--_state: var(--norn-ui-state-hover, t('ui.state.hover'));
				}

				&:active {
					--_state: var(--norn-ui-state-press, t('ui.state.press'));
				}

				&:has(input:checked) {
					--_tint: color-mix(in oklab, var(--_current) 14%, transparent);
					color: var(--_current);
				}

				/* The ring sits inside the option, clear of the track's edge. */
				&:has(input:focus-visible) {
					outline: var(--norn-ui-focus-width, t('ui.focus.width')) solid var(--norn-text-accent, t('text.accent'));
					outline-offset: calc(-1 * var(--norn-ui-focus-offset, t('ui.focus.offset')));
				}
			}

			& input {
				box-sizing: border-box;
				position: absolute;
				inset: 0;
				z-index: 1;
				margin: 0;
				opacity: 0;
				cursor: pointer;
			}

			@media (pointer: coarse) {
				& label {
					min-block-size: 2.75rem;
				}
			}

			@media (prefers-reduced-motion: no-preference) {
				& label {
					transition: background-color var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing')),
						color var(--norn-ui-motion-duration, t('ui.motion.duration')) var(--norn-ui-motion-easing, t('ui.motion.easing'));
				}
			}

			/* The checked option fills itself, since the browser replaces the tint. */
			@media (forced-colors: active) {
				& label:has(input:checked) {
					background-color: Highlight;
					color: HighlightText;
					forced-color-adjust: none;
				}

				& label:has(input:focus-visible) {
					outline-color: CanvasText;
				}
			}
		}
	}
</style>
