/**
 * Short facts in a row, such as a license or a runtime: an optional icon and a few words each, with no box. Static text, not controls.
 * Pass each fact as an `<li>`, which may start with a `norn-icon`. The list has `role="list"`, which Safari needs once the markers are gone.
 * @prop {string} [gap] - The space between rows: `xs`, the default, `s`, `m`, or `l`, each a `--norn-space-*` step. The facts in a row are always `m` apart. A hero sets `l`.
 * @slot - The facts, as `<li>` elements.
 * @category component
 */
--->
<ul role="list" :data-gap="['s', 'm', 'l'].includes(gap) ? gap : undefined"><slot></slot></ul>
<style>
	@layer norn.components {
		norn-fact-list {
			display: block;

			& ul {
				display: flex;
				flex-wrap: wrap;
				gap: var(--norn-space-xs, t('space.xs')) var(--norn-space-m, t('space.m'));
				margin: 0;
				padding: 0;
				list-style: none;
				color: var(--norn-text-muted, t('text.muted'));
				font-size: var(--norn-font-size-s, t('font.size.s'));

				&[data-gap="s"] {
					row-gap: var(--norn-space-s, t('space.s'));
				}

				&[data-gap="m"] {
					row-gap: var(--norn-space-m, t('space.m'));
				}

				&[data-gap="l"] {
					row-gap: var(--norn-space-l, t('space.l'));
				}
			}

			& li {
				display: inline-flex;
				align-items: center;
				gap: var(--norn-space-2xs, t('space.2xs'));
				max-inline-size: 100%;
				line-height: 1.5;
				overflow-wrap: anywhere;
			}

			& norn-icon {
				color: var(--norn-text-accent, t('text.accent'));
			}
		}
	}
</style>
