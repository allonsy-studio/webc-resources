/**
 * Head metadata, the cascade layer order, and the page's bundle links. `norn-base` calls it; a layout of the project's own can too.
 * Call it in the head as `<meta webc:is="norn-page-head" webc:nokeep … />`: a custom tag in the head would close it early.
 * Emits Open Graph tags and `twitter:card`: `summary_large_image` when an image is set, else `summary`. Write extra head tags right after the call: they land after the bundle links.
 * Declares the layer order in an inline style before the bundle links, so it comes first whatever order the page's styles bundle in:
 * `norn.reset, norn.base, norn.layout, norn.components, norn.oss, norn.print`. A project's unlayered CSS beats every layer without `!important`.
 * The base and print styles are files, `css/base.css` and `css/print.css`: `norn-base` embeds them, and a layout of the project's own adds them itself.
 * Register `dropEmptyBundleTags` as a transform so a page without CSS or JS keeps no empty `<link>` or `<script>`; the Norn plugin does.
 * @prop {string} title
 * @prop {string} [description]
 * @prop {string} [url] - The canonical URL. Checked with `typeof`: a missing `url` prop resolves to Eleventy's `url` filter.
 * @prop {string} [theme-color] - One color for both schemes. Without it, the page surface in each scheme.
 * @prop {string} [og-title] - Falls back to the title.
 * @prop {string} [og-image] - The share image, for `og:image`. Open Graph needs an absolute URL, so a relative one resolves against the canonical `url`. When `url` is not absolute, the build logs a warning, and `og:image` and `og:image:alt` are left out, with a `summary` card. Without an image, no image tag renders.
 * @prop {string} [og-image-alt] - The image's description, for `og:image:alt`. Ignored without `og-image`.
 * @prop {boolean} [theme-toggle] - Adds a small inline script that applies the scheme a `norn-theme-toggle` saved, before the first paint. On for `@theme-toggle`, `@theme-toggle="true"`, or `:@theme-toggle="true"`.
 * @category document
 */
--->
<script webc:setup>
/** Whether the page sets a share image. Checked with `typeof`: a missing `og-image` prop can resolve to page data. */
function hasImage(src) {
	return typeof src === "string" && src !== "";
}

/**
 * The absolute URL for `og:image`: the image resolved against the canonical URL.
 * A relative image with no absolute canonical URL logs a warning and returns `''`, because Open Graph readers ignore a relative one.
 * Call it once per render: it warns each time.
 */
function absoluteImage(src, base) {
	if (!hasImage(src)) return "";
	try {
		return new URL(src, typeof base === "string" && base ? base : undefined).href;
	} catch {
		console.warn(`norn-page-head: og-image "${src}" is relative, so the canonical url must be absolute to resolve it against. The og:image and og:image:alt tags are left out. Pass an absolute og-image or url.`);
		return "";
	}
}
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style webc:keep>@layer norn.reset, norn.base, norn.layout, norn.components, norn.oss, norn.print;</style>
<title @text="title"></title>
<meta webc:if="description" name="description" :content="description" />
<link webc:if="typeof url === 'string'" rel="canonical" :href="url" />
<meta name="color-scheme" content="light dark" />
<script webc:if="themeToggle === true || themeToggle === '' || themeToggle === 'true'" webc:keep>
	try {
		const scheme = localStorage.getItem("color-scheme");
		if (scheme === "light" || scheme === "dark") document.documentElement.style.colorScheme = scheme;
	} catch {}
</script>
<meta webc:if="themeColor" name="theme-color" :content="themeColor" />
<meta webc:if="!themeColor" name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta webc:if="!themeColor" name="theme-color" content="#101216" media="(prefers-color-scheme: dark)" />
<meta property="og:type" content="website" />
<meta property="og:title" :content="ogTitle || title" />
<meta webc:if="description" property="og:description" :content="description" />
<meta webc:if="typeof url === 'string'" property="og:url" :content="url" />
<template webc:for="image of [absoluteImage(ogImage, url)]" webc:nokeep>
<meta webc:if="image" property="og:image" :content="image" />
<meta webc:if="image && typeof ogImageAlt === 'string' && ogImageAlt" property="og:image:alt" :content="ogImageAlt" />
<meta name="twitter:card" :content="image ? 'summary_large_image' : 'summary'" />
</template>
<link rel="stylesheet" :href="getBundleFileUrl('css')" webc:keep />
<script :src="getBundleFileUrl('js')" defer webc:keep></script>
