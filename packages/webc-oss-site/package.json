{
	"name": "@allons-y/webc-oss-site",
	"version": "0.1.0-beta.0",
	"description": "The OSS site theme for Norn sites: Allons-y Studio brand tokens, self-hosted fonts, and the locked OSS banner, call to action, and footer credit.",
	"license": "MPL-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/allonsy-studio/webc-resources/tree/main/packages/webc-oss-site#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/webc-resources.git",
		"directory": "packages/webc-oss-site"
	},
	"bugs": {
		"url": "https://github.com/allonsy-studio/webc-resources/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"type": "module",
	"exports": {
		".": "./index.js",
		"./css/tokens.css": "./css/tokens.css",
		"./css/brand.css": "./css/brand.css",
		"./schema/oss-docs.schema.json": "./schema/oss-docs.schema.json",
		"./package.json": "./package.json"
	},
	"files": [
		"components/",
		"css/",
		"fonts/",
		"schema/",
		"index.js",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"prepack": "node ../../scripts/build-components.js webc-oss-site && yarn copy:svg && yarn copy:fonts",
		"copy:fonts": "node scripts/copy-fonts.js",
		"copy:svg": "node scripts/inline-svg.js"
	},
	"peerDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-plugin-webc": "^0.11.0",
		"@allons-y/webc-patterns": "^0.1.0-beta.0"
	},
	"keywords": [
		"webc",
		"eleventy",
		"11ty"
	],
	"engines": {
		"node": ">=22"
	}
}
