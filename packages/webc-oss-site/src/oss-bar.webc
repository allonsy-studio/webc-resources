<aside aria-labelledby="oss-bar-label"><p id="oss-bar-label"><span>Brought to you by</span> <a href="https://allons-y.studio"><span data-script>Allons<span data-dash>-</span>y</span> <span data-caps>Studio</span></a></p></aside>
<style>
	@layer norn.oss {
		oss-bar {
			--_ink: #33394e;
			--_paper: #fbf9f3;
			--_focus: #ffd36c;
			display: block;
			background: var(--_ink);
			color: var(--_paper);
			font-size: var(--norn-font-size-s, t('font.size.s'));

			& > aside > p {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: center;
				gap: var(--norn-space-2xs, t('space.2xs')) var(--norn-space-xs, t('space.xs'));
				margin: 0;
				padding: var(--norn-space-xs, t('space.xs')) var(--norn-space-m, t('space.m'));
				line-height: 1.5;
			}

			& > aside > p > a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4em;
				color: inherit;
				text-decoration: none;

				&:hover {
					text-decoration: underline;
				}

				&:focus-visible {
					outline-color: var(--_focus);
				}
			}

			/* The wordmark: Yellowtail with the magenta dash, over Instrument Sans caps. */
			& [data-script] {
				font-family: "Yellowtail", "Yellowtail Fallback", cursive;
				font-size: 1.6em;
				line-height: 1;
			}

			& [data-dash] {
				color: #c92c6b;
			}

			& [data-caps] {
				font-size: 0.85em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			@media print {
				display: none;
			}
		}
	}
</style>
