/**
 * The OSS site head: the PT Mono preload and the self-hosted `@font-face` rules for PT Mono, Instrument Sans, and Yellowtail, each with a fallback matched to its metrics.
 * The OSS site plugin puts it in `norn-base`'s head hook, followed by the brand tokens from `css/tokens.css`. Call it elsewhere as `<meta webc:is="oss-head" webc:nokeep />`.
 * The `@font-face` rules look for the fonts at `assets/fonts`, one level up from the bundle: the OSS site plugin copies the package's `fonts` folder there.
 * The brand tokens it goes with, in `css/tokens.css` and the `norn.oss` layer, are below. The brand rules in `css/brand.css` follow them in the same layer, such as the four-color strip along the header bar and the footer's project name in the accent color and the mono face, at 1.2rem. A project's unlayered CSS still wins over both.
 * @cssprop --norn-font-mono - Set to PT Mono, Allons-y Studio's locked monospace.
 * @category document
 */
--->
<link rel="preload" href="/assets/fonts/pt-mono.woff2" as="font" type="font/woff2" crossorigin />
<style>
	/* The fonts sit at assets/fonts: from the bundle, one level up. Each fallback matches its font's metrics. */
	@font-face {
		font-family: "PT Mono";
		src: url("../assets/fonts/pt-mono.woff2") format("woff2");
		font-weight: 400;
		font-display: swap;
	}

	@font-face {
		font-family: "PT Mono Fallback";
		src: local("Courier New"), local("CourierNewPSMT"), local("Liberation Mono"), local("Courier");
		size-adjust: 100%;
		ascent-override: 88.5%;
		descent-override: 23.5%;
		line-gap-override: 0%;
	}

	@font-face {
		font-family: "Instrument Sans";
		src: url("../assets/fonts/instrument-sans-var.woff2") format("woff2");
		font-weight: 400 700;
		font-display: swap;
	}

	@font-face {
		font-family: "Instrument Sans";
		src: url("../assets/fonts/instrument-sans-italic-var.woff2") format("woff2");
		font-style: italic;
		font-weight: 400 700;
		font-display: swap;
	}

	@font-face {
		font-family: "Instrument Sans Fallback";
		src: local("Arial"), local("ArialMT"), local("Liberation Sans"), local("Helvetica");
		size-adjust: 102.6%;
		ascent-override: 94.54%;
		descent-override: 24.37%;
		line-gap-override: 0%;
	}

	@font-face {
		font-family: "Instrument Sans Fallback";
		src: local("Arial Italic"), local("Arial-ItalicMT"), local("Liberation Sans Italic"), local("Helvetica Oblique");
		font-style: italic;
		size-adjust: 102.52%;
		ascent-override: 94.61%;
		descent-override: 24.39%;
		line-gap-override: 0%;
	}

	@font-face {
		font-family: "Yellowtail";
		src: url("../assets/fonts/yellowtail.woff2") format("woff2");
		font-weight: 400;
		font-display: swap;
	}

	@font-face {
		font-family: "Yellowtail Fallback";
		src: local("Arial"), local("ArialMT"), local("Liberation Sans"), local("Helvetica");
		size-adjust: 73.65%;
		ascent-override: 131.93%;
		descent-override: 40.91%;
		line-gap-override: 12.2%;
	}
</style>
