<section>
	<svg aria-hidden="true" width="72" height="72" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M 433.41 375.67 A 214 214 0 0 1 209.68 464.93" fill="none" stroke="#7BD1E6" stroke-width="42" stroke-linecap="butt"/><circle cx="433.41" cy="375.67" r="21.00" fill="#7BD1E6"/><path d="M 188.10 458.94 A 214 214 0 0 1 42.29 267.20" fill="none" stroke="#C92C6B" stroke-width="42" stroke-linecap="butt"/><path d="M 42.29 244.80 A 214 214 0 0 1 188.10 53.06" fill="none" stroke="#FF9A56" stroke-width="42" stroke-linecap="butt"/><path d="M 209.68 47.07 A 214 214 0 0 1 433.41 136.33" fill="none" stroke="#FFD36C" stroke-width="42" stroke-linecap="butt"/><circle cx="433.41" cy="136.33" r="21.00" fill="#FFD36C"/><rect x="374" y="224" width="118" height="64" rx="26" fill="#EFEBDF" stroke="#33394E" stroke-width="16"/><circle cx="256" cy="256" r="150" fill="#EFEBDF" stroke="#33394E" stroke-width="16"/><circle cx="256" cy="256" r="104" fill="#C2B1A6"/></svg>
	<div>
		<p><span data-signature>Allons-y Studio</span></p>
		<h3 webc:if="Number(level) === 3">Let's build something great together</h3>
		<h4 webc:elseif="Number(level) === 4">Let's build something great together</h4>
		<h2 webc:else>Let's build something great together</h2>
		<p>A front-end &amp; design systems studio helping teams ship consistent, accessible UI faster.</p>
	</div>
	<ul role="list">
		<li><norn-link-button @href="https://scheduler.zoom.us/allonsy-studio/discovery">Book a discovery call</norn-link-button></li>
		<li><norn-link-button @href="mailto:consulting@allons-y.studio" @variant="secondary">Email the studio</norn-link-button></li>
	</ul>
</section>
<style>
	@layer norn.oss {
		oss-cta {
			/* Yellow is the section's one accent: an ink-on-yellow primary action, and a darkened yellow for the secondary's text on cream. */
			--_yellow: light-dark(#ffd36c, #ffc53d);
			--_signature: "Yellowtail", "Yellowtail Fallback", cursive;
			--norn-ui-accent: var(--_yellow);
			--norn-text-accent: light-dark(#7d5208, #ffd147);
			--norn-text-on-accent: #33394e;
			display: block;
			container-type: inline-size;
			inline-size: min(100% - 2 * var(--norn-space-m, t('space.m')), 64rem);
			margin: var(--norn-space-xl, t('space.xl')) auto 0;

			& section {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				align-items: center;
				gap: var(--norn-space-m, t('space.m')) var(--norn-space-l, t('space.l'));
				padding: var(--norn-space-l, t('space.l'));
				border-radius: var(--norn-ui-border-radius, t('ui.border.radius'));
				background: var(--norn-surface-raised, t('surface.raised'));
				color: var(--norn-text-base, t('text.base'));
			}

			& svg {
				inline-size: 4.5rem;
				block-size: auto;
			}

			& section > div {
				display: grid;
				gap: 0.4rem;
			}

			& p {
				margin: 0;
			}

			& section > div > p:first-child {
				font-weight: 600;
			}

			/* The Allons-y Studio name is signed. */
			& [data-signature] {
				font-family: var(--_signature);
				font-size: 1.3em;
				font-weight: 400;
				line-height: 1;
			}

			& section > div > p:first-child [data-signature] {
				font-size: 1.5em;
			}

			& section > div > :is(h2, h3, h4) {
				margin: 0;
				font-size: clamp(1.35rem, 3vw, 1.75rem);
			}

			& ul {
				display: flex;
				flex-direction: row;
				flex-wrap: wrap;
				gap: var(--norn-space-s, t('space.s'));
				margin: 0;
				padding: 0;
				list-style: none;
			}

			@container (max-width: 37.5rem) {
				& section {
					grid-template-columns: minmax(0, 1fr);
				}
			}

			@media print {
				display: none;
			}
		}
	}
</style>
