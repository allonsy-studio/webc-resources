<p>Built &amp; maintained by <a href="https://allons-y.studio">Allons-y Studio</a></p>
<p data-signoff>Allons-y!</p>
<style>
	@layer norn.oss {
		oss-credit {
			display: grid;
			justify-items: end;
			align-content: start;
			gap: var(--norn-space-2xs, t('space.2xs'));
			text-align: end;

			& > p {
				margin: 0;
			}

			/* The studio signs off in its script face. */
			& > [data-signoff] {
				color: var(--norn-text-base, t('text.base'));
				font-family: "Yellowtail", "Yellowtail Fallback", cursive;
				font-size: var(--norn-font-size-xl, t('font.size.xl'));
				line-height: 1.15;
			}
		}
	}
</style>
